#!/bin/bash
#
# Claude Container Launcher
# A convenient script to run Claude Code in a Docker container
#
# Usage:
#   claude-container [options] [command]
#
# Options:
#   --workspace, -w <path>  Set workspace directory (default: current directory)
#   --config, -c <path>     Set config directory (default: $HOME/.config/claude-container)
#   --proxy                 Enable API logging proxy
#   --proxy-data <path>     Set proxy data directory (default: ./proxy-data)
#   --proxy-stop            Stop and cleanup proxy container
#   --proxy-logs            Show proxy logs
#   --mount <path>          Bind-mount host <path> at the same path in the container (repeatable)
#   --help, -h              Show this help message
#
# Examples:
#   claude-container                    # Run in current directory
#   claude-container --proxy            # Run with API logging proxy
#   claude-container --proxy-stop       # Stop proxy and cleanup
#   claude-container -w /path/to/code   # Run with custom workspace
#

set -e

# Version information
# Container and proxy are always released with the same version
VERSION="1.7.0"

# Default values
WORKSPACE_DIR="$(pwd)"
CONFIG_BASE_DIR="$HOME/.config/claude-container"
CONFIG_DIR="$HOME/.config/claude-container/config"
PROXY_DATA_DIR="$HOME/.config/claude-container/proxy-data"
IMAGE="nezhar/claude-container:${VERSION}"
PROXY_IMAGE="nezhar/claude-proxy:${VERSION}"
DATASETTE_IMAGE="nezhar/claude-datasette:${VERSION}"
# Default command: just launch Claude Code. Permission prompts are disabled via
# the config dir's settings.json (permissions.defaultMode = bypassPermissions,
# written by ensure_bypass_permissions below) rather than the
# --dangerously-skip-permissions flag, because that flag's interactive acceptance
# screen regressed in recent Claude Code versions. The settings-based mode applies
# to ALL `claude` launches in the container, including explicit ones like
# `claude-container claude --resume`. The container is an isolated sandbox
# (workspace + config bind-mounts only), so the approval flow just gets in the way.
COMMAND="claude"
USE_PROXY=false
USE_DATASETTE=false
NETWORK_NAME="claude-network"
PROXY_CONTAINER_NAME="claude-proxy"
DATASETTE_CONTAINER_NAME="claude-datasette"
DATASETTE_PORT=8001
SHELL_MODE=false
TMUX_MODE=false
# Port mappings published from the workspace overlay (docker run -p args)
PORT_ARGS=()
# Runtime docker flags from the workspace overlay's overlay.json — --cap-add,
# --device, --sysctl and -e, built from an ALLOWLIST (see the overlay parsing
# below for why it is an allowlist and not a passthrough).
OVERLAY_RUNTIME_ARGS=()
# Extra docker run args assembled at launch time (e.g. tmux mount + env)
EXTRA_DOCKER_ARGS=()
# Caller-requested same-path bind mounts (--mount <path>): each host <path> is
# bound at the IDENTICAL path inside the container. Used to make sibling repos'
# git common-dirs (referenced by absolute gitdir pointers in nested worktrees)
# resolve unchanged. Unlike overlay.json these are supplied per-launch by the
# caller, not committed with the repo, so an arbitrary host path is acceptable.
MOUNT_SPECS=()
# Skill sharing: agents inside the container propose skills into the workspace's
# .claude-container-skills/; skills adopted user-wide live in USER_SKILLS_DIR and
# are offered to every project; per-project accept/reject choices are sticky and
# live in SKILL_CHOICES_DIR (one file per workspace).
USER_SKILLS_DIR="$CONFIG_BASE_DIR/user-skills"
SKILL_CHOICES_DIR="$CONFIG_BASE_DIR/skill-choices"
# A skill may ship an image-build fragment beside its SKILL.md. Unlike SKILL.md
# (a runtime-only input), this text is concatenated into the effective overlay
# Dockerfile and RUNS AS ROOT at image build time -- see collect_skill_fragments.
# A skill.json manifest (see skill_manifest_get) may point "image.dockerfile" at
# a differently-named fragment; overlay.Dockerfile remains the zero-config default.
SKILL_FRAGMENT_FILE="overlay.Dockerfile"
# A skill may declare a phase-aware manifest beside its SKILL.md: image fragment,
# runtime privileges, boot drop-in, host services, and preflight requirements.
# See the manifest helpers below (skill_manifest_get) and docs/design.
SKILL_MANIFEST_FILE="skill.json"
# Set by collect_skill_fragments: the concatenated fragment text, and the
# ordered names of the skills that contributed it.
SKILL_FRAGMENT_BUILD=""
SKILL_FRAGMENT_NAMES=()
# Names reserved by the image's baked-in skills (the entrypoint re-deploys these
# on every container start, so managed skills must not collide with them).
BUNDLED_SKILL_NAMES="container-overlay container-tmux container-skills container-services"
SKILLS_ACTION=""
SKILLS_NAME=""
# Skills disabled for THIS launch by preflight (a hard `requires` failure) or a
# withheld privilege consent. active_skills and the fragment/runtime/boot passes
# all skip these, so a disabled skill contributes nothing this launch.
DISABLED_SKILLS=""
# --skills-ignore-new: launch without prompting about undecided user-wide skills
# (use whatever has already been accepted; leave new ones undecided for later).
SKILLS_IGNORE_NEW=false
# Named services: every container publishes a single in-container mux (svc-mux,
# fixed container port below) on an EPHEMERAL host port, so any number of
# concurrent containers — e.g. one per git worktree — never collide on host
# ports. Launches register {instance, workspace, mux port} in SERVICES_DIR; the
# claude-container-router daemon reads it to give services stable names
# (http://<service>.<instance>.claude.localhost:8484/) and raw TCP forwards
# (--service-port). Service name -> container port lives in overlay.json's
# "services" object, resolved live inside the container, so services declared
# mid-session need no restart.
SERVICES_DIR="$CONFIG_BASE_DIR/services"
MUX_CONTAINER_PORT=7999
# Host services: launcher-supervised HOST processes the container reaches by name
# — the mirror of the in-container `services` above. Declared by a skill manifest
# ("hostServices") or a project overlay.json ("hostServices"). The launcher starts
# them before the container, health-checks, restarts per policy, and stops them on
# exit. HOST_EXEC_ALLOW is the user-editable allowlist of program names a host
# service may launch (the single host-exec control, design §6). See
# start_host_services / stop_host_services.
HOST_EXEC_ALLOW_FILE="$CONFIG_BASE_DIR/host-exec-allow"
HOST_SVC_RUN_DIR=""
HOST_SVC_STOPFLAG=""
HOST_SVC_SUPERVISORS=()
ROUTER_ACTION=""
SERVICE_PORT_SPEC=""
SERVICE_INSTANCE=""
CC_CONTAINER_NAME=""

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to display help
show_help() {
    cat << 'EOF'
Claude Container Launcher

A convenient script to run Claude Code in a Docker container with optional API logging.

USAGE:
    claude-container [OPTIONS] [COMMAND]

OPTIONS:
    -w, --workspace <path>      Set workspace directory (default: current directory)
    -c, --config <path>         Set config directory (default: $HOME/.config/claude-container/config)
    -h, --help                  Show this help message
    -v, --version               Show version information (Claude Container, Claude Code, Docker)
    --pull                      Pull latest images before running
    --shell                     Drop into container shell instead of starting Claude
    --tmux                      Run Claude inside a named tmux session (mounts the
                                host's ~/.tmux.conf) so you can open extra shells
    --mount <path>              Bind-mount host <path> at the IDENTICAL path inside
                                the container (repeatable). Useful so sibling/nested
                                linked worktrees whose .git points at other repos'
                                git dirs by absolute path resolve in the container.

PROXY OPTIONS:
    --proxy                     Enable API logging proxy
    --proxy-data <path>         Set proxy data directory (default: $HOME/.config/claude-container/proxy-data)
    --proxy-stop                Stop and cleanup proxy container
    --proxy-logs                Show proxy container logs

DATASETTE OPTIONS:
    --datasette                 Enable Datasette for data visualization (requires --proxy)
    --datasette-only            Start only Datasette (database must already exist)
    --datasette-port <port>     Set Datasette port (default: 8001)
    --datasette-stop            Stop and cleanup Datasette container
    --datasette-logs            Show Datasette container logs

SERVICE OPTIONS:
    --services                  List running instances and their named services
    --service-port <inst>/<svc> Print a host port that pipes raw TCP to a named
                                service (allocated on demand, non-HTTP protocols)
    --router-start              Start the host service router (DNS + HTTP)
    --router-stop               Stop the host service router
    --router-status             Show router status and registered services
    --router-logs               Tail the router log

SKILLS OPTIONS:
    --skills                    List user-wide + workspace skills and this project's choices
    --skills-adopt <name>       Copy a workspace skill into the user-wide set
    --skills-accept <name>      Include a user-wide skill in this project (sticky)
    --skills-reject <name>      Exclude a user-wide skill from this project (sticky)
    --skills-reset              Forget this project's choices (prompt again next launch)
    --skills-fragments          Print the Dockerfile text skills add to this image
    --skills-drop <name>        Remove a skill from the user-wide set
    --skills-ignore-new         Launch without prompting about undecided skills
                                (use only what's already accepted; decide later)

EXAMPLES:
    claude-container                                # Run Claude (permission prompts disabled) in current dir
    claude-container --proxy                        # Run with API logging enabled
    claude-container --proxy --datasette            # Run with logging and data visualization
    claude-container --datasette-only               # Start only Datasette (if database exists)
    claude-container --proxy-stop                   # Stop the proxy container
    claude-container --datasette-stop               # Stop the Datasette container
    claude-container --proxy-logs                   # View proxy logs
    claude-container --datasette-logs               # View Datasette logs
    claude-container -w /path/to/project            # Run with custom workspace
    claude-container --pull                         # Pull latest images and run
    claude-container --shell                        # Access container shell before starting Claude
    claude-container --tmux                         # Run Claude inside a tmux session
    claude-container --mount /repos/other/.git      # Also expose another repo's git dir at the same path
    claude-container --skills                       # List skills and this project's choices
    claude-container --skills-adopt my-skill        # Share a workspace skill with all projects
    claude-container ls -la                         # Run custom command in container

ENVIRONMENT VARIABLES:
    CLAUDE_WORKSPACE        Override default workspace directory
    CLAUDE_CONFIG           Override default config directory
    CLAUDE_PROXY_DATA       Override default proxy data directory
    CLAUDE_IMAGE            Override default Docker image
    CLAUDE_PROXY_IMAGE      Override default proxy image
    CLAUDE_DATASETTE_IMAGE  Override default Datasette image

PROXY DATABASE:
    When using --proxy, all API requests are logged to: <proxy-data>/requests.db

    View recent requests:
        sqlite3 proxy-data/requests.db "SELECT timestamp, method, path, response_status FROM request_logs ORDER BY timestamp DESC LIMIT 10;"

DATASETTE VISUALIZATION:
    When using --datasette, a web UI is available at http://localhost:8001
    This provides an interactive interface to explore and analyze your API request logs.

FIRST TIME SETUP:
    On first run, you'll be prompted to authenticate with Claude.
    Your credentials will be stored in the config directory for future use.

WORKSPACE OVERLAY:
    A .claude-container-overlay/ directory at the workspace root layers
    project-specific state on top of the shared base image:

        .claude-container-overlay/
        ├── Dockerfile      Build fragment appended to the base image (the
        │                   overlay directory is the build context, so COPY
        │                   of files in it works). Use this to persist tools
        │                   like apt packages, Nix, or global CLIs.
        ├── overlay.json    Structured runtime config:
        │                   {"ports": ["8080:8080"], "services": {"web": 8099}}
        │                   "ports" entries go straight to "docker run -p";
        │                   "services" declares NAMED services (see below);
        │                   "capabilities"/"devices"/"sysctls"/"env" add
        │                   --cap-add/--device/--sysctl/-e (see below).
        ├── startup.sh      Optional hook run once per container start, just
        │                   before Claude — for setup that needs the live
        │                   container (start a daemon, join a network).
        └── skills/<name>/  Skills proposed by Claude from inside the container
                            (deployed at launch; only an overlay.Dockerfile
                            inside one is baked into the image -- see below).

    The built image is tagged claude-container-overlay:<hash> over the base
    image plus the build inputs; overlay.json, startup.sh and skills/ files
    other than overlay.Dockerfile are excluded from the hash, so changing ports,
    the startup hook or skill prose never triggers a rebuild.

    RUNTIME FLAGS are an allowlist, not a passthrough — there is deliberately
    no way to express -v, --privileged, --pid=host or --network=host, because
    overlay.json is committed with the repo and applied silently at the next
    launch. Invalid entries are skipped with a warning; the launch continues.

        "capabilities": ["NET_ADMIN"]              --cap-add (ALL is refused)
        "devices":      ["/dev/net/tun"]           --device  (paths under /dev/)
        "sysctls":      {"net.ipv4.ip_forward": 1} --sysctl  (namespaced only)
        "env":          ["TS_AUTHKEY"]             -e

    A bare "env" name forwards the value from the launching environment and
    keeps it out of the container's argv — prefer it for secrets. "NAME=value"
    sets a literal.

    startup.sh runs to completion as the mapped non-root user (use sudo if it
    needs root), under a timeout (CLAUDE_STARTUP_TIMEOUT, default 120s). A hook
    that fails or times out warns and lets the session continue.

    The legacy form — a single .claude-container-overlay Dockerfile-fragment
    file with "# claude-container:port <mapping>" directive comments — is still
    supported.

GIT WORKTREES:
    A workspace that is a linked git worktree keeps its repository (objects,
    refs, index) in the main checkout's .git directory, outside the workspace.
    The launcher detects this and bind-mounts the main repository's .git
    directory into the container at the path the worktree's pointer expects,
    so git works normally inside. Run one container per worktree freely — they
    share the main .git the same way concurrent worktrees do on the host.

BUNDLED SKILLS:
    The image ships with Claude Code skills baked in (container-overlay,
    container-tmux, container-skills, container-services). They are deployed
    into the skills directory automatically on container start, so Claude knows
    how to use the overlay, tmux, skill-sharing, and named-service features in
    every workspace — no per-project setup required.

SKILL IMAGE FRAGMENTS:
    A skill can ship an `overlay.Dockerfile` next to its SKILL.md. The effective
    set's fragments are concatenated ahead of the workspace's own overlay
    Dockerfile, so a skill can install a toolchain (Nix, a compiler, a runtime)
    that the project's overlay then builds on. Fragments run AS ROOT at image
    build time.

    Order is per-project and append-only (recorded in
    ~/.config/claude-container/skill-choices/<project>.order): a newly accepted
    skill is appended rather than inserted, so existing layers stay cached. A
    name keeps its slot forever -- rejecting and re-accepting a skill restores
    its original position at no rebuild cost.

    Fragments cannot COPY: the docker build context is the workspace overlay
    directory, which does not contain the skill directories. Fetch inside a RUN.

    Because a user-wide skill is shared across projects, editing one changes the
    image of every project that accepted it. That rebuild is CONFIRMED at launch
    rather than performed silently; declining keeps the previously built image
    and asks again next launch. Review the exact text first with
    --skills-fragments.

SKILL SHARING:
    Claude can propose new skills from inside the container by writing them to
    <workspace>/.claude-container-overlay/skills/<name>/SKILL.md (the bundled
    container-skills skill teaches it how). Workspace skills are always deployed
    for their own project at launch.

    Adopt one into the user-wide set (~/.config/claude-container/user-skills)
    with --skills-adopt to offer it to every claude-container project: each
    project is prompted once at launch to accept or reject it, and the answer is
    sticky (stored under ~/.config/claude-container/skill-choices). Use --skills
    to review, and --skills-accept/--skills-reject/--skills-reset to manage a
    project's choices. A linked git worktree inherits its main checkout's
    choices, so you decide about each skill once per repo, not once per worktree.

NAMED SERVICES:
    Fixed "ports" mappings collide when several containers run at once (e.g.
    one per git worktree). Named services avoid that: declare
    {"services": {"dashboard": 8099}} in overlay.json and each container
    publishes only a single mux on an EPHEMERAL host port. The
    claude-container-router daemon (started automatically at launch) then
    serves every instance's services by name:

        http://<service>.<instance>.claude.localhost/        (no DNS setup)
        http://<service>.<instance>.claude/                  (via its DNS server)
        http://127.0.0.1:8484/<instance>/<service>/...       (path form)
        http://127.0.0.1:8484/                               (index of everything)
        claude-container --service-port <instance>/<service> (raw TCP port)

    Portless URLs need the router to hold port 80: automatic on macOS; on
    Linux run 'sudo sysctl -w net.ipv4.ip_unprivileged_port_start=80' first.
    Otherwise append :8484 — --services always prints the working URLs.

    <instance> is the workspace directory's basename (suffixed with a short
    hash on collisions) — see --services for the live list. Service names are
    resolved inside the container on every connection, so Claude can declare a
    new service in overlay.json mid-session and it is immediately reachable,
    no restarts. The DNS server (default 127.0.0.1:8453/udp, domain .claude)
    is optional sugar; see the README for /etc/resolver and systemd-resolved
    wiring.

TMUX SESSION (--tmux):
    With --tmux, Claude runs inside a tmux session named "claude" and the host's
    ~/.tmux.conf is mounted in. You can open additional shells in the container
    with your tmux prefix (e.g. prefix + c) and run commands without going through
    Claude, and Claude can drive/observe windows via "tmux" and "tmux send-keys"
    against the canonical "claude" session. See the container-tmux skill.

EOF
}

# Ensure the container always runs Claude with permission prompts disabled.
#
# We do this via the config dir's settings.json (permissions.defaultMode =
# bypassPermissions) instead of the --dangerously-skip-permissions flag: the flag
# now gates behind an interactive acceptance screen that doesn't persist in recent
# Claude Code versions (so it silently falls back to per-action prompts), whereas
# the settings-based mode is honored on every launch with no prompt. The setting
# is merged into any existing settings.json, preserving other keys, and applies to
# every `claude` invocation in the container (default or explicit).
ensure_bypass_permissions() {
    local settings="$CONFIG_DIR/settings.json"
    if command -v python3 >/dev/null 2>&1; then
        SETTINGS_PATH="$settings" python3 - <<'PY' || echo -e "${YELLOW}Warning: could not update $settings (Claude may prompt for permissions).${NC}"
import json, os
path = os.environ["SETTINGS_PATH"]
data = {}
if os.path.exists(path):
    try:
        with open(path) as f:
            data = json.load(f)
        if not isinstance(data, dict):
            data = {}
    except Exception:
        # Preserve the unparseable file rather than clobbering it.
        os.replace(path, path + ".bak")
        data = {}
perms = data.setdefault("permissions", {})
if perms.get("defaultMode") != "bypassPermissions":
    perms["defaultMode"] = "bypassPermissions"
    with open(path, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
PY
    elif [ ! -f "$settings" ]; then
        # No python3 and no existing settings: write a minimal one.
        printf '{\n  "permissions": {\n    "defaultMode": "bypassPermissions"\n  }\n}\n' > "$settings"
    elif ! grep -q "bypassPermissions" "$settings"; then
        echo -e "${YELLOW}Warning: python3 not found; cannot merge bypassPermissions into $settings.${NC}"
        echo -e "${YELLOW}Add '\"permissions\": {\"defaultMode\": \"bypassPermissions\"}' to it to disable prompts.${NC}"
    fi
}

# --- Skill sharing ------------------------------------------------------------
#
# Skills flow through three tiers:
#
#   1. Workspace skills    <workspace>/.claude-container-overlay/skills/<name>/
#      Proposed by Claude from inside the container (see the bundled
#      container-skills skill). Always deployed for their own project.
#   2. User-wide skills    $USER_SKILLS_DIR/<name>/
#      Adopted from a workspace with --skills-adopt; offered to every project.
#   3. Per-project choices  $SKILL_CHOICES_DIR/<project-key>.conf
#      Records accept/reject per user-wide skill, per project. An undecided
#      skill prompts once at launch; y/n answers are sticky, skip asks again.
#      A linked git worktree keys off its MAIN working tree (skill_identity_dir),
#      so all worktrees of a repo share one set of choices.
#
# Before each run the effective set (workspace skills + accepted user-wide
# skills) is synced into $CONFIG_DIR/skills. A manifest file records which
# entries the launcher manages, so rejected/dropped skills are cleaned up
# without touching skills the user placed there by hand or the image-bundled
# ones (the entrypoint re-deploys those on every container start).

sha256_12() {
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 | cut -c1-12
    else
        sha256sum | cut -c1-12
    fi
}

# Stable per-directory identity: readable basename + path hash. Defaults to the
# workspace; callers pass an explicit dir when they want a different identity
# (skill choices key off the main worktree — see skill_identity_dir).
project_key() {
    local dir="${1:-$WORKSPACE_DIR}" hash
    hash=$(printf '%s' "$dir" | sha256_12)
    printf '%s-%s\n' "$(basename "$dir" | tr -c 'a-zA-Z0-9_.-' '-' | sed 's/-*$//')" "$hash"
}

# The directory whose identity keys this project's skill choices. For a linked
# git worktree that is the MAIN working tree, so every worktree of a repo shares
# one set of accept/reject choices (decide about a skill once, not once per
# worktree). Regular repos — and submodules, which are their own projects (their
# gitdir has no commondir file) — key off the workspace itself. Cached in
# SKILL_IDENTITY_DIR; WORKSPACE_DIR is already finalized before any caller runs.
skill_identity_dir() {
    local gitfile pointer host_gitdir commonrel host_common
    gitfile="$WORKSPACE_DIR/.git"
    if [ -f "$gitfile" ]; then
        pointer=$(sed -n 's/^gitdir:[[:space:]]*//p' "$gitfile" | head -1)
        case "$pointer" in
            /*) host_gitdir="$pointer" ;;
            "") host_gitdir="" ;;
            *)  host_gitdir="$WORKSPACE_DIR/$pointer" ;;
        esac
        if [ -n "$host_gitdir" ] && host_gitdir="$(cd "$host_gitdir" 2>/dev/null && pwd)" \
           && [ -f "$host_gitdir/commondir" ]; then
            commonrel="$(head -1 "$host_gitdir/commondir")"
            case "$commonrel" in
                /*) host_common="$commonrel" ;;
                *)  host_common="$host_gitdir/$commonrel" ;;
            esac
            # host_common is the main repo's git common dir (…/.git); its parent
            # is the main working tree.
            if host_common="$(cd "$host_common" 2>/dev/null && pwd)"; then
                printf '%s\n' "$(dirname "$host_common")"
                return 0
            fi
        fi
    fi
    printf '%s\n' "$WORKSPACE_DIR"
}

choices_file() {
    if [ -z "${SKILL_IDENTITY_DIR:-}" ]; then
        SKILL_IDENTITY_DIR="$(skill_identity_dir)"
    fi
    printf '%s/%s.conf\n' "$SKILL_CHOICES_DIR" "$(project_key "$SKILL_IDENTITY_DIR")"
}

# Per-project record of the ORDER in which skill fragments are concatenated.
# Append-only: a name keeps the slot it was first given, so adopting a new skill
# appends a layer rather than inserting one and invalidating everything after
# it. Names are never pruned -- a skill that is rejected and later re-accepted
# returns to its original slot, costing no rebuild.
skill_order_file() {
    if [ -z "${SKILL_IDENTITY_DIR:-}" ]; then
        SKILL_IDENTITY_DIR="$(skill_identity_dir)"
    fi
    printf '%s/%s.order\n' "$SKILL_CHOICES_DIR" "$(project_key "$SKILL_IDENTITY_DIR")"
}

# Per-project record of the last overlay image actually built, and the digest of
# the skill-fragment block it was built from. Lets the launcher tell "the
# fragments changed under this project" (confirm before rebuilding) apart from
# "this project's own overlay changed" (rebuild silently, as before).
skill_build_state_file() {
    if [ -z "${SKILL_IDENTITY_DIR:-}" ]; then
        SKILL_IDENTITY_DIR="$(skill_identity_dir)"
    fi
    printf '%s/%s.build\n' "$SKILL_CHOICES_DIR" "$(project_key "$SKILL_IDENTITY_DIR")"
}

# Per-project record of the privilege digest a project has CONSENTED to for each
# privileged skill (design §6). Accepting/adopting a privileged skill records the
# digest of its declared privileges here; a later launch re-checks it, so a skill
# that starts requesting new privileges is not auto-granted them.
skill_consent_file() {
    if [ -z "${SKILL_IDENTITY_DIR:-}" ]; then
        SKILL_IDENTITY_DIR="$(skill_identity_dir)"
    fi
    printf '%s/%s.consent\n' "$SKILL_CHOICES_DIR" "$(project_key "$SKILL_IDENTITY_DIR")"
}

get_skill_consent() {
    local file
    file="$(skill_consent_file)"
    [ -f "$file" ] || return 0
    sed -n "s/^$1=//p" "$file" | tail -1
    return 0
}

set_skill_consent() {
    local name="$1" digest="$2" file tmp
    file="$(skill_consent_file)"
    mkdir -p "$SKILL_CHOICES_DIR"
    [ -f "$file" ] || printf '# claude-container per-project privilege consent (skill=digest)\n' > "$file"
    tmp="$file.tmp"
    grep -v "^$name=" "$file" > "$tmp" 2>/dev/null || true
    printf '%s=%s\n' "$name" "$digest" >> "$tmp"
    mv "$tmp" "$file"
}

valid_skill_name() {
    [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]]
}

# Read a dotted key out of a skill directory's skill.json manifest, printing the
# value (scalars verbatim; objects/arrays as compact JSON). Non-zero when there
# is no manifest, no python3, or the key is absent — so callers can `|| default`.
# The manifest is optional: a skill with none behaves exactly as it did before
# manifests existed (pure instructions, plus a bare overlay.Dockerfile if any).
skill_manifest_get() {
    local dir="$1" key="$2"
    [ -f "$dir/$SKILL_MANIFEST_FILE" ] || return 1
    command -v python3 >/dev/null 2>&1 || return 1
    MF="$dir/$SKILL_MANIFEST_FILE" KEY="$key" python3 - <<'PY'
import json, os, sys
try:
    data = json.load(open(os.environ["MF"]))
except Exception:
    sys.exit(1)
cur = data
for part in os.environ["KEY"].split("."):
    if isinstance(cur, dict) and part in cur:
        cur = cur[part]
    else:
        sys.exit(1)
if cur is None:
    sys.exit(1)
print(json.dumps(cur) if isinstance(cur, (dict, list)) else cur)
PY
}

# Emit "<name>\t<dir>" for each skill active in this project: workspace skills
# first, then accepted user-wide skills, with the workspace copy winning a name
# collision and image-bundled names excluded. This is the single source of truth
# for "the effective skill set", mirroring sync_skills' membership rules, and is
# reused by every phase (image fragments, runtime merge, boot drop-ins, host
# services, preflight, and consent).
active_skills() {
    local name seen=" "
    for name in $(list_skill_dirs "$WORKSPACE_SKILLS_DIR"); do
        valid_skill_name "$name" || continue
        is_bundled_skill "$name" && continue
        case " $DISABLED_SKILLS " in *" $name "*) continue ;; esac
        printf '%s\t%s\n' "$name" "$WORKSPACE_SKILLS_DIR/$name"
        seen="$seen$name "
    done
    for name in $(list_skill_dirs "$USER_SKILLS_DIR"); do
        valid_skill_name "$name" || continue
        is_bundled_skill "$name" && continue
        case " $seen" in *" $name "*) continue ;; esac
        case " $DISABLED_SKILLS " in *" $name "*) continue ;; esac
        [ "$(get_skill_choice "$name")" = "accept" ] || continue
        printf '%s\t%s\n' "$name" "$USER_SKILLS_DIR/$name"
    done
}

# Resolve the image-build fragment a skill directory contributes, honouring the
# manifest's "image.dockerfile" (relative to the skill dir) and falling back to a
# bare overlay.Dockerfile. Prints the fragment path; non-zero when the skill
# contributes none. A manifest path that escapes the skill dir is ignored.
skill_fragment_file() {
    local dir="$1" rel
    rel="$(skill_manifest_get "$dir" image.dockerfile 2>/dev/null)" || rel=""
    if [ -n "$rel" ]; then
        case "$rel" in
            /*|*..*) return 1 ;;
        esac
        [ -f "$dir/$rel" ] && { printf '%s\n' "$dir/$rel"; return 0; }
        return 1
    fi
    [ -f "$dir/$SKILL_FRAGMENT_FILE" ] && { printf '%s\n' "$dir/$SKILL_FRAGMENT_FILE"; return 0; }
    return 1
}

# True when a skill directory ships an image-build fragment (manifest-declared or
# the bare overlay.Dockerfile default).
skill_has_fragment() {
    skill_fragment_file "$1" >/dev/null 2>&1
}

# Describe or digest the PRIVILEGES a skill directory declares (design §6). A
# skill is "privileged" when it contributes an image layer (a root RUN), runtime
# capabilities/devices/env, or a host service — any of these is an escalation the
# user must consent to. `mode` is:
#   summary   -> human-readable privilege lines (for the consent diff), rc 0
#   digest    -> a stable 12-char digest of the enabling contributions, rc 0
#   check     -> rc 0 if privileged, rc 1 if not (prints nothing)
# The digest folds the fragment TEXT plus the manifest's image/runtime/
# hostServices/container blocks, so any change to what a skill would run re-opens
# consent. A bare overlay.Dockerfile with no manifest is privileged too (its RUN
# still executes as root).
skill_privilege_info() {
    local dir="$1" mode="$2" frag
    frag="$(skill_fragment_file "$dir" 2>/dev/null)" || frag=""
    CC_SKILL_DIR="$dir" CC_FRAG="$frag" CC_MODE="$mode" CC_MANIFEST="$SKILL_MANIFEST_FILE" \
        python3 - <<'PY'
import json, hashlib, os, sys

d = os.environ["CC_SKILL_DIR"]
frag = os.environ["CC_FRAG"]
mode = os.environ["CC_MODE"]
manifest_path = os.path.join(d, os.environ["CC_MANIFEST"])

manifest = {}
if os.path.exists(manifest_path):
    try:
        manifest = json.load(open(manifest_path)) or {}
    except Exception:
        manifest = {}
if not isinstance(manifest, dict):
    manifest = {}

frag_text = ""
if frag and os.path.exists(frag):
    try:
        frag_text = open(frag).read()
    except OSError:
        frag_text = ""

image = manifest.get("image") or {}
runtime = manifest.get("runtime") or {}
host_services = manifest.get("hostServices") or {}
container = manifest.get("container") or {}

privileged = bool(frag_text) or bool(runtime) or bool(host_services)
if mode == "check":
    sys.exit(0 if privileged else 1)

if mode == "digest":
    blob = json.dumps(
        {"frag": frag_text, "runtime": runtime, "hostServices": host_services,
         "image": image, "container": container},
        sort_keys=True,
    )
    print(hashlib.sha256(blob.encode()).hexdigest()[:12])
    sys.exit(0)

# mode == "summary": one line per declared privilege.
lines = []
caps = runtime.get("capabilities") or []
if isinstance(caps, str):
    caps = [caps]
devs = runtime.get("devices") or []
if isinstance(devs, str):
    devs = [devs]
envs = runtime.get("env") or []
if isinstance(envs, str):
    envs = [envs]
sysctls = runtime.get("sysctls") or {}
ports = runtime.get("ports") or []
if isinstance(ports, str):
    ports = [ports]
if caps:
    lines.append(f"kernel capabilities: {', '.join(map(str, caps))}")
if devs:
    lines.append(f"host devices: {', '.join(map(str, devs))}")
if envs:
    lines.append(f"host env passthrough: {', '.join(str(e).split('=')[0] for e in envs)}")
if sysctls:
    lines.append(f"sysctls: {', '.join(sysctls)}")
if ports:
    lines.append(f"published ports: {', '.join(map(str, ports))}")
if frag_text:
    lines.append("an image build layer that RUNS AS ROOT at build time")
if container.get("startup"):
    lines.append(f"a boot hook: {container.get('startup')}")
for name, svc in host_services.items():
    start = (svc or {}).get("start", "?") if isinstance(svc, dict) else "?"
    lines.append(f"a HOST process '{name}': {start}")
for ln in lines:
    print(ln)
PY
}

skill_is_privileged() {
    skill_privilege_info "$1" check
}

# True when a skill has been disabled for this launch (preflight/consent). Such a
# skill is treated like a rejected one: not deployed, no fragment, no runtime, no
# boot hook, no host service.
skill_disabled() {
    case " $DISABLED_SKILLS " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

# Print a privileged skill's privilege diff and record the project's consent to
# the current privilege digest (design §6). Called from the explicit consent
# surfaces: --skills-accept and --skills-adopt (running either IS the consent).
# A no-op for a non-privileged skill.
consent_record_for() {
    local name="$1" dir="$2" ln
    skill_is_privileged "$dir" || return 0
    echo -e "${BLUE}'$name' is a privileged skill. It grants this project:${NC}"
    while IFS= read -r ln; do
        [ -n "$ln" ] && echo -e "  ${YELLOW}- $ln${NC}"
    done < <(skill_privilege_info "$dir" summary)
    set_skill_consent "$name" "$(skill_privilege_info "$dir" digest 2>/dev/null)"
    echo -e "${BLUE}Consent recorded for this project. You'll be re-asked only if these change.${NC}"
    return 0
}

# Preflight the active skill set BEFORE the image build / runtime merge / boot
# assembly (design §5.5 + §6). For each active skill: validate its `requires`
# (a launcher too old disables it; a missing host device or unset env warns), and
# gate its declared privileges on recorded consent — an interactive launch shows
# the privilege diff and asks; a non-interactive one warns and proceeds so
# automation is never wedged. Disabled skills are added to DISABLED_SKILLS, which
# every later pass skips.
preflight_skills() {
    local name dir digest recorded answer ln interactive=false
    [ -t 0 ] && [ -t 1 ] && interactive=true
    while IFS=$'\t' read -r name dir; do
        [ -n "$name" ] || continue
        if ! skill_requires_preflight "$name" "$dir"; then
            DISABLED_SKILLS="$DISABLED_SKILLS $name"
            continue
        fi
        skill_is_privileged "$dir" || continue
        digest="$(skill_privilege_info "$dir" digest 2>/dev/null)"
        recorded="$(get_skill_consent "$name")"
        if [ -n "$digest" ] && [ "$recorded" = "$digest" ]; then
            continue   # already consented to exactly these privileges
        fi
        if [ "$interactive" = false ]; then
            if [ -z "$recorded" ]; then
                echo -e "${YELLOW}Skill '$name' declares privileges not yet consented to (non-interactive — proceeding):${NC}" >&2
            else
                echo -e "${YELLOW}Skill '$name' CHANGED its requested privileges since you consented (non-interactive — proceeding):${NC}" >&2
            fi
            while IFS= read -r ln; do
                [ -n "$ln" ] && echo -e "${YELLOW}    - $ln${NC}" >&2
            done < <(skill_privilege_info "$dir" summary)
            echo -e "${YELLOW}  Re-consent with: claude-container --skills-accept $name${NC}" >&2
            continue
        fi
        if [ -z "$recorded" ]; then
            echo -e "${BLUE}Skill '${name}' requests these privileges for this project:${NC}"
        else
            echo -e "${BLUE}Skill '${name}' CHANGED the privileges it requests since you last consented:${NC}"
        fi
        while IFS= read -r ln; do
            [ -n "$ln" ] && echo -e "  ${YELLOW}- $ln${NC}"
        done < <(skill_privilege_info "$dir" summary)
        while true; do
            printf 'Grant these to this project? [y]es / [n]o: '
            read -r answer < /dev/tty || answer="n"
            case "$answer" in
                y|Y|yes)
                    set_skill_consent "$name" "$digest"
                    break ;;
                n|N|no|"")
                    echo -e "${YELLOW}  Not granted — disabling '$name' this launch (wire it by hand per its SKILL.md, or re-run and accept).${NC}"
                    DISABLED_SKILLS="$DISABLED_SKILLS $name"
                    break ;;
                *) echo "Please answer y or n." ;;
            esac
        done
    done < <(active_skills)
}

# Preflight a skill's `requires` block (design §5.5). Prints diagnostics and
# returns non-zero ONLY for a hard failure that means the skill cannot work at
# all (the launcher is older than requires.launcher) — the caller then disables
# it. A missing host device or unset env is a WARNING: the session still opens
# (tailnet just skips the join), and the message keeps a later cryptic failure
# from being a mystery.
skill_requires_preflight() {
    local name="$1" dir="$2" req launchreq minver dev envname
    skill_manifest_get "$dir" requires >/dev/null 2>&1 || return 0

    launchreq="$(skill_manifest_get "$dir" requires.launcher 2>/dev/null)" || launchreq=""
    if [ -n "$launchreq" ]; then
        # Accept ">=X.Y.Z" or a bare "X.Y.Z" (treated as a minimum).
        minver="${launchreq#>=}"
        minver="${minver# }"
        if [ -n "$minver" ] && [ "$(printf '%s\n%s\n' "$minver" "$VERSION" | sort -V | head -1)" != "$minver" ]; then
            echo -e "${RED}Skill '$name' requires claude-container >= ${minver}, but this launcher is ${VERSION}.${NC}" >&2
            echo -e "${YELLOW}  Disabling '$name' this launch; upgrade the launcher to enable it, or wire it by hand (see its SKILL.md).${NC}" >&2
            return 1
        fi
    fi

    while IFS= read -r dev; do
        [ -n "$dev" ] || continue
        if [ ! -e "$dev" ]; then
            echo -e "${YELLOW}Skill '$name': host device ${dev} is not present on this host.${NC}" >&2
            echo -e "${YELLOW}  If the join/setup fails later, this is why — the Docker engine's VM must expose ${dev}.${NC}" >&2
        fi
    done < <(skill_manifest_get "$dir" requires.hostDevices 2>/dev/null | python3 -c 'import sys,json;
try:
    v=json.load(sys.stdin)
except Exception:
    v=[]
[print(x) for x in ([v] if isinstance(v,str) else (v or []))]' 2>/dev/null)

    while IFS= read -r envname; do
        [ -n "$envname" ] || continue
        if [ -z "${!envname:-}" ]; then
            echo -e "${YELLOW}Skill '$name': env ${envname} is not set in the launching environment; the skill runs without it (its setup may be skipped).${NC}" >&2
        fi
    done < <(skill_manifest_get "$dir" requires.env 2>/dev/null | python3 -c 'import sys,json;
try:
    v=json.load(sys.stdin)
except Exception:
    v=[]
[print(x) for x in ([v] if isinstance(v,str) else (v or []))]' 2>/dev/null)
    return 0
}

is_bundled_skill() {
    local n
    for n in $BUNDLED_SKILL_NAMES; do
        if [ "$1" = "$n" ]; then
            return 0
        fi
    done
    return 1
}

# Subdirectories of $1 that contain a SKILL.md, one name per line.
list_skill_dirs() {
    local d
    if [ ! -d "$1" ]; then
        return 0
    fi
    for d in "$1"/*/; do
        if [ -f "${d}SKILL.md" ]; then
            basename "$d"
        fi
    done
    return 0
}

# First frontmatter description line of a skill, for listings and prompts.
skill_description() {
    sed -n 's/^description:[[:space:]]*//p' "$1/SKILL.md" 2>/dev/null | head -1 | cut -c1-100
    return 0
}

get_skill_choice() {
    local file
    file="$(choices_file)"
    if [ ! -f "$file" ]; then
        return 0
    fi
    sed -n "s/^$1=//p" "$file" | tail -1
    return 0
}

set_skill_choice() {
    local name="$1" choice="$2" file tmp
    file="$(choices_file)"
    mkdir -p "$SKILL_CHOICES_DIR"
    if [ ! -f "$file" ]; then
        printf '# claude-container per-project skill choices\n# workspace: %s\n' "${SKILL_IDENTITY_DIR:-$WORKSPACE_DIR}" > "$file"
    fi
    tmp="$file.tmp"
    grep -v "^$name=" "$file" > "$tmp" || true
    printf '%s=%s\n' "$name" "$choice" >> "$tmp"
    mv "$tmp" "$file"
}

# Ask once, per project, about each user-wide skill with no recorded choice.
# y/n answers are sticky (stored in the choices file); skip asks again next time.
prompt_undecided_skills() {
    local name choice desc answer
    if [ "$SKILLS_IGNORE_NEW" = true ] || [ ! -t 0 ] || [ ! -t 1 ]; then
        return 0
    fi
    for name in $(list_skill_dirs "$USER_SKILLS_DIR"); do
        if ! valid_skill_name "$name" || is_bundled_skill "$name"; then
            continue
        fi
        choice="$(get_skill_choice "$name")"
        if [ -n "$choice" ]; then
            continue
        fi
        desc="$(skill_description "$USER_SKILLS_DIR/$name")"
        echo -e "${BLUE}New user-wide skill:${NC} ${YELLOW}${name}${NC}${desc:+ — $desc}"
        if skill_is_privileged "$USER_SKILLS_DIR/$name"; then
            local pln
            echo -e "${YELLOW}  This is a PRIVILEGED skill. Accepting grants this project:${NC}"
            while IFS= read -r pln; do
                [ -n "$pln" ] && echo -e "${YELLOW}    - $pln${NC}"
            done < <(skill_privilege_info "$USER_SKILLS_DIR/$name" summary)
        fi
        while true; do
            printf 'Include it in this project? [y]es / [n]o / [s]kip for now: '
            read -r answer < /dev/tty || answer="s"
            case "$answer" in
                y|Y|yes)
                    set_skill_choice "$name" accept
                    if skill_is_privileged "$USER_SKILLS_DIR/$name"; then
                        set_skill_consent "$name" "$(skill_privilege_info "$USER_SKILLS_DIR/$name" digest 2>/dev/null)"
                    fi
                    break
                    ;;
                n|N|no)
                    set_skill_choice "$name" reject
                    break
                    ;;
                s|S|skip|"")
                    echo -e "${BLUE}Skipped — you'll be asked again next launch.${NC}"
                    break
                    ;;
                *)
                    echo "Please answer y, n, or s."
                    ;;
            esac
        done
    done
    return 0
}

# Sync the effective skill set for this project (workspace skills + accepted
# user-wide skills) into the config dir's skills directory. Workspace skills win
# name collisions with user-wide ones; bundled names are reserved.
sync_skills() {
    local skills_dest="$CONFIG_DIR/skills"
    local manifest="$skills_dest/.claude-container-managed"
    local -a names srcs
    names=()
    srcs=()
    local name existing found old idx

    for name in $(list_skill_dirs "$WORKSPACE_SKILLS_DIR"); do
        if ! valid_skill_name "$name"; then
            echo -e "${YELLOW}Skipping workspace skill '$name': names must be lowercase letters, digits, and hyphens.${NC}"
            continue
        fi
        if is_bundled_skill "$name"; then
            echo -e "${YELLOW}Skipping workspace skill '$name': the name is reserved by an image-bundled skill.${NC}"
            continue
        fi
        skill_disabled "$name" && continue
        names+=("$name")
        srcs+=("$WORKSPACE_SKILLS_DIR/$name")
    done

    for name in $(list_skill_dirs "$USER_SKILLS_DIR"); do
        if ! valid_skill_name "$name" || is_bundled_skill "$name"; then
            continue
        fi
        if [ "$(get_skill_choice "$name")" != "accept" ]; then
            continue
        fi
        skill_disabled "$name" && continue
        found=false
        for existing in "${names[@]}"; do
            if [ "$existing" = "$name" ]; then
                found=true
            fi
        done
        if [ "$found" = true ]; then
            continue  # workspace copy wins the collision
        fi
        names+=("$name")
        srcs+=("$USER_SKILLS_DIR/$name")
    done

    # Nothing to manage and nothing managed before: leave the dir untouched.
    if [ ${#names[@]} -eq 0 ] && [ ! -f "$manifest" ]; then
        return 0
    fi

    mkdir -p "$skills_dest"

    # Remove previously managed skills that fell out of the set (rejected,
    # dropped user-wide, or deleted from the workspace).
    if [ -f "$manifest" ]; then
        while IFS= read -r old; do
            if [ -z "$old" ] || ! valid_skill_name "$old"; then
                continue
            fi
            found=false
            for existing in "${names[@]}"; do
                if [ "$existing" = "$old" ]; then
                    found=true
                fi
            done
            if [ "$found" = false ]; then
                rm -rf "$skills_dest/${old:?}"
            fi
        done < "$manifest"
    fi

    if [ ${#names[@]} -eq 0 ]; then
        rm -f "$manifest"
        return 0
    fi

    : > "$manifest.tmp"
    idx=0
    while [ "$idx" -lt ${#names[@]} ]; do
        rm -rf "$skills_dest/${names[$idx]:?}"
        cp -a "${srcs[$idx]}" "$skills_dest/${names[$idx]}"
        printf '%s\n' "${names[$idx]}" >> "$manifest.tmp"
        idx=$((idx + 1))
    done
    mv "$manifest.tmp" "$manifest"
    echo -e "${GREEN}Skills deployed for this project:${NC} ${YELLOW}${names[*]}${NC}"
    return 0
}

# Concatenate the image-build fragments shipped by the effective skill set into
# SKILL_FRAGMENT_BUILD, in a per-project append-only order (see
# skill_order_file). Mirrors sync_skills' membership rules: workspace skills,
# then accepted user-wide ones, with the workspace copy winning a name
# collision.
#
# The result is prepended to the workspace's own overlay Dockerfile, so skills
# provide the foundation (a toolchain, an interpreter, Nix) and the project's
# own fragment can build on top of it. That ordering costs a rebuild of the
# workspace fragment's layers when a skill is added -- the cheap, volatile end
# of the image -- while leaving the expensive shared skill layers cached.
#
# Fragments cannot COPY: the docker build context is the workspace overlay
# directory, which does not contain the skill dirs. Fetch inside a RUN instead.
collect_skill_fragments() {
    local order_file name src frag existing found
    local -a ordered
    SKILL_FRAGMENT_BUILD=""
    SKILL_FRAGMENT_NAMES=()
    ordered=()

    order_file="$(skill_order_file)"
    if [ -f "$order_file" ]; then
        while IFS= read -r name; do
            if [ -n "$name" ] && valid_skill_name "$name"; then
                ordered+=("$name")
            fi
        done < "$order_file"
    fi

    # Append names that carry a fragment and aren't in the recorded order yet.
    for name in $(list_skill_dirs "$WORKSPACE_SKILLS_DIR") $(list_skill_dirs "$USER_SKILLS_DIR"); do
        if ! valid_skill_name "$name" || is_bundled_skill "$name"; then
            continue
        fi
        skill_disabled "$name" && continue
        src="$(skill_fragment_source "$name")" || continue
        found=false
        for existing in ${ordered[@]+"${ordered[@]}"}; do
            if [ "$existing" = "$name" ]; then
                found=true
            fi
        done
        if [ "$found" = false ]; then
            ordered+=("$name")
        fi
    done

    if [ ${#ordered[@]} -eq 0 ]; then
        return 0
    fi

    mkdir -p "$SKILL_CHOICES_DIR"
    printf '%s\n' "${ordered[@]}" > "$order_file"

    # Emit in recorded order, skipping names that no longer contribute one.
    for name in "${ordered[@]}"; do
        skill_disabled "$name" && continue
        src="$(skill_fragment_source "$name")" || continue
        frag="$(cat "$src")"
        if printf '%s\n' "$frag" | grep -qiE '^[[:space:]]*(FROM|COPY|ADD)[[:space:]]'; then
            echo -e "${YELLOW}Warning: skill '$name' fragment uses FROM/COPY/ADD.${NC}"
            echo -e "${YELLOW}FROM starts a new stage and discards earlier layers; COPY/ADD cannot see${NC}"
            echo -e "${YELLOW}the skill directory (the build context is the workspace overlay dir).${NC}"
        fi
        SKILL_FRAGMENT_BUILD+="# --- claude-container: fragment from skill '$name' ---"$'\n'
        SKILL_FRAGMENT_BUILD+="$frag"$'\n'
        SKILL_FRAGMENT_NAMES+=("$name")
    done

    if [ ${#SKILL_FRAGMENT_NAMES[@]} -gt 0 ]; then
        echo -e "${GREEN}Skill image fragments:${NC} ${YELLOW}${SKILL_FRAGMENT_NAMES[*]}${NC}"
    fi
    return 0
}

# Path to the fragment a named skill contributes for THIS project, honouring the
# same precedence as sync_skills (workspace copy wins). Non-zero when the skill
# contributes none, so callers can `|| continue`.
skill_fragment_source() {
    local name="$1"
    if [ -f "$WORKSPACE_SKILLS_DIR/$name/SKILL.md" ]; then
        skill_fragment_file "$WORKSPACE_SKILLS_DIR/$name"
        return $?
    fi
    if [ -f "$USER_SKILLS_DIR/$name/SKILL.md" ] \
        && [ "$(get_skill_choice "$name")" = "accept" ]; then
        skill_fragment_file "$USER_SKILLS_DIR/$name"
        return $?
    fi
    return 1
}

# Point out workspace skills that haven't been adopted user-wide yet.
suggest_adoptable_skills() {
    local name
    for name in $(list_skill_dirs "$WORKSPACE_SKILLS_DIR"); do
        if ! valid_skill_name "$name" || is_bundled_skill "$name"; then
            continue
        fi
        if [ -d "$USER_SKILLS_DIR/$name" ]; then
            continue
        fi
        echo -e "${BLUE}Workspace skill '${name}' can be shared with every project:${NC} claude-container --skills-adopt ${name}"
    done
    return 0
}

skills_list() {
    local name choice status desc any
    echo -e "${GREEN}User-wide skills${NC} (${USER_SKILLS_DIR}):"
    any=false
    for name in $(list_skill_dirs "$USER_SKILLS_DIR"); do
        any=true
        choice="$(get_skill_choice "$name")"
        case "$choice" in
            accept) status="${GREEN}accepted${NC}" ;;
            reject) status="${RED}rejected${NC}" ;;
            *)      status="${YELLOW}undecided — will prompt at next launch${NC}" ;;
        esac
        desc="$(skill_description "$USER_SKILLS_DIR/$name")"
        if skill_has_fragment "$USER_SKILLS_DIR/$name"; then
            status="${status}; ${YELLOW}builds into the image${NC}"
        fi
        echo -e "  ${name} [${status}]${desc:+ — $desc}"
    done
    if [ "$any" = false ]; then
        echo "  (none)"
    fi
    echo ""
    echo -e "${GREEN}Workspace skills${NC} (${WORKSPACE_SKILLS_DIR}):"
    any=false
    for name in $(list_skill_dirs "$WORKSPACE_SKILLS_DIR"); do
        any=true
        if [ -d "$USER_SKILLS_DIR/$name" ]; then
            status="always active here; adopted user-wide"
        else
            status="always active here; adopt with --skills-adopt $name"
        fi
        desc="$(skill_description "$WORKSPACE_SKILLS_DIR/$name")"
        if skill_has_fragment "$WORKSPACE_SKILLS_DIR/$name"; then
            status="${status}; builds into the image"
        fi
        echo -e "  ${name} [${status}]${desc:+ — $desc}"
    done
    if [ "$any" = false ]; then
        echo "  (none)"
    fi
    echo ""
    echo -e "Project: ${YELLOW}${WORKSPACE_DIR}${NC}"
    echo -e "Choices: ${YELLOW}$(choices_file)${NC}"
    return 0
}

# Print the exact Dockerfile text the effective skill set contributes to this
# project's image, in build order. This runs as root at image build time, so it
# is worth reading before accepting a rebuild.
skills_fragments() {
    collect_skill_fragments >/dev/null
    if [ ${#SKILL_FRAGMENT_NAMES[@]} -eq 0 ]; then
        echo "No skill active in this project contributes an image fragment."
        echo ""
        echo -e "Order file: ${YELLOW}$(skill_order_file)${NC}"
        return 0
    fi
    echo -e "${GREEN}Skill image fragments${NC} (build order; prepended to this project's overlay Dockerfile):"
    echo ""
    printf '%s' "$SKILL_FRAGMENT_BUILD"
    echo ""
    echo -e "Order file: ${YELLOW}$(skill_order_file)${NC}"
    echo -e "Build state: ${YELLOW}$(skill_build_state_file)${NC}"
    return 0
}

skills_adopt() {
    local name="$1" src updated
    if ! valid_skill_name "$name"; then
        echo -e "${RED}Error: invalid skill name '$name' (lowercase letters, digits, hyphens).${NC}"
        exit 1
    fi
    if is_bundled_skill "$name"; then
        echo -e "${RED}Error: '$name' is reserved by an image-bundled skill.${NC}"
        exit 1
    fi
    src="$WORKSPACE_SKILLS_DIR/$name"
    if [ ! -f "$src/SKILL.md" ]; then
        echo -e "${RED}Error: no workspace skill named '$name' (looked in $WORKSPACE_SKILLS_DIR).${NC}"
        echo -e "${YELLOW}Run 'claude-container --skills' to see what's available.${NC}"
        exit 1
    fi
    mkdir -p "$USER_SKILLS_DIR"
    updated=false
    if [ -d "$USER_SKILLS_DIR/$name" ]; then
        updated=true
    fi
    rm -rf "$USER_SKILLS_DIR/${name:?}"
    cp -a "$src" "$USER_SKILLS_DIR/$name"
    set_skill_choice "$name" accept
    if [ "$updated" = true ]; then
        echo -e "${GREEN}Updated user-wide skill '$name' from this workspace.${NC}"
    else
        echo -e "${GREEN}Adopted '$name' into the user-wide skill set.${NC}"
    fi
    consent_record_for "$name" "$USER_SKILLS_DIR/$name"
    echo -e "${BLUE}Accepted for this project automatically; other projects are prompted at their next launch.${NC}"
    return 0
}

skills_drop() {
    local name="$1"
    if ! valid_skill_name "$name" || [ ! -d "$USER_SKILLS_DIR/$name" ]; then
        echo -e "${RED}Error: no user-wide skill named '$name'.${NC}"
        exit 1
    fi
    rm -rf "$USER_SKILLS_DIR/${name:?}"
    echo -e "${GREEN}Removed '$name' from the user-wide skill set.${NC}"
    echo -e "${BLUE}Projects that had it deployed clean it up on their next launch.${NC}"
    return 0
}

skills_set_project_choice() {
    local name="$1" choice="$2"
    if ! valid_skill_name "$name"; then
        echo -e "${RED}Error: invalid skill name '$name'.${NC}"
        exit 1
    fi
    if [ ! -f "$USER_SKILLS_DIR/$name/SKILL.md" ]; then
        echo -e "${RED}Error: no user-wide skill named '$name'.${NC}"
        if [ -f "$WORKSPACE_SKILLS_DIR/$name/SKILL.md" ]; then
            echo -e "${YELLOW}'$name' is a workspace skill (always active in this project).${NC}"
            echo -e "${YELLOW}Adopt it user-wide first: claude-container --skills-adopt $name${NC}"
        else
            echo -e "${YELLOW}Run 'claude-container --skills' to see available skills.${NC}"
        fi
        exit 1
    fi
    set_skill_choice "$name" "$choice"
    if [ "$choice" = "accept" ]; then
        consent_record_for "$name" "$USER_SKILLS_DIR/$name"
        echo -e "${GREEN}Skill '$name' accepted for this project. It will be deployed on the next launch.${NC}"
    else
        echo -e "${GREEN}Skill '$name' rejected for this project. Any deployed copy is removed on the next launch.${NC}"
    fi
    return 0
}

skills_reset() {
    local file
    file="$(choices_file)"
    if [ -f "$file" ]; then
        rm -f "$file"
        echo -e "${GREEN}Cleared this project's skill choices. You'll be prompted again at the next launch.${NC}"
    else
        echo -e "${BLUE}No skill choices recorded for this project.${NC}"
    fi
    return 0
}

# --- Git worktree support -----------------------------------------------------
#
# A linked git worktree keeps only a pointer in the workspace: .git is a FILE
# containing "gitdir: <main-repo>/.git/worktrees/<name>", and the repository
# proper (objects, refs, config, plus the worktree's own index/HEAD) lives in
# the main repository's .git directory OUTSIDE the workspace. Mounting just the
# worktree therefore leaves git in the container with a dangling pointer
# ("fatal: not a git repository").
#
# Fix: bind-mount the main repository's .git directory at the path the pointer
# resolves to INSIDE the container, so .git -> gitdir -> commondir all resolve
# unchanged. With the usual absolute pointer that is the same absolute path as
# on the host; with a relative pointer (worktree.useRelativePaths) it is the
# path resolved against /workspace. Mounted read-write — commits from the
# worktree write objects and refs there. Submodule workspaces (.git pointing at
# <parent>/.git/modules/<path>, no commondir file) get the same treatment.
setup_worktree_git_mount() {
    local gitfile pointer host_gitdir host_common commonrel target
    gitfile="$WORKSPACE_DIR/.git"
    if [ ! -f "$gitfile" ]; then
        return 0  # a directory (regular repo) or absent: nothing to do
    fi
    pointer=$(sed -n 's/^gitdir:[[:space:]]*//p' "$gitfile" | head -1)
    if [ -z "$pointer" ]; then
        return 0
    fi
    case "$pointer" in
        /*) host_gitdir="$pointer" ;;
        *)  host_gitdir="$WORKSPACE_DIR/$pointer" ;;
    esac
    if ! host_gitdir="$(cd "$host_gitdir" 2>/dev/null && pwd)"; then
        echo -e "${YELLOW}Warning: $gitfile points at '$pointer', which doesn't resolve on the host; git won't work in the container.${NC}"
        return 0
    fi
    # The directory to mount: the main repo's .git for worktrees (commondir is
    # normally '../..' from .git/worktrees/<name>); the module gitdir itself
    # for submodules (no commondir file).
    host_common="$host_gitdir"
    commonrel=""
    if [ -f "$host_gitdir/commondir" ]; then
        commonrel="$(head -1 "$host_gitdir/commondir")"
        case "$commonrel" in
            /*) host_common="$commonrel" ;;
            *)  host_common="$host_gitdir/$commonrel" ;;
        esac
        if ! host_common="$(cd "$host_common" 2>/dev/null && pwd)"; then
            echo -e "${YELLOW}Warning: could not resolve the git commondir behind $gitfile; git won't work in the container.${NC}"
            return 0
        fi
    fi
    case "$host_common" in
        "$WORKSPACE_DIR"/*) return 0 ;;  # inside the workspace mount already
    esac
    case "$pointer" in
        /*)
            # Absolute pointer: the container must see the same absolute path.
            target="$host_common"
            ;;
        *)
            # Relative pointer: it resolves against /workspace in the
            # container. Replay the pointer + commondir walk from /workspace
            # and normalize (the resulting path exists only in the container).
            if ! command -v python3 >/dev/null 2>&1; then
                echo -e "${YELLOW}Warning: python3 not found; cannot map the relative gitdir pointer in $gitfile. Git won't work in the container.${NC}"
                return 0
            fi
            target=$(CC_POINTER="$pointer" CC_COMMONREL="$commonrel" python3 - <<'PY'
import os
path = os.path.normpath(os.path.join("/workspace", os.environ["CC_POINTER"]))
common = os.environ["CC_COMMONREL"]
if os.path.isabs(common):
    path = common
elif common:
    path = os.path.normpath(os.path.join(path, common))
print(path)
PY
)
            ;;
    esac
    EXTRA_DOCKER_ARGS+=(-v "$host_common:$target")
    echo -e "${GREEN}Git worktree workspace — also mounting the main repo's git dir:${NC} ${YELLOW}$host_common${NC}"
    return 0
}

# --- Extra same-path bind mounts (--mount) ------------------------------------
#
# Each --mount <path> binds the host <path> at the SAME absolute path inside the
# container. This mirrors how setup_worktree_git_mount handles an absolute gitdir
# pointer (target == host path), so nested/sibling linked worktrees whose .git
# pointers reference OTHER repos' git common-dirs by absolute host path resolve
# unchanged. Paths already inside the workspace mount are skipped (they are
# visible via /workspace already).
setup_extra_mounts() {
    local spec resolved
    for spec in "${MOUNT_SPECS[@]}"; do
        if ! resolved="$(cd "$spec" 2>/dev/null && pwd)"; then
            echo -e "${YELLOW}Warning: --mount path does not exist on the host, skipping:${NC} ${spec}"
            continue
        fi
        case "$resolved" in
            "$WORKSPACE_DIR"|"$WORKSPACE_DIR"/*)
                echo -e "${YELLOW}--mount path is inside the workspace (already mounted), skipping:${NC} ${resolved}"
                continue
                ;;
        esac
        EXTRA_DOCKER_ARGS+=(-v "$resolved:$resolved")
        echo -e "${GREEN}Extra bind mount (same path):${NC} ${YELLOW}$resolved${NC}"
    done
}

# --- Named services -----------------------------------------------------------
#
# See the SERVICES_DIR comment at the top of the file for the architecture.
# The launcher's part: name the container, publish the in-container mux on an
# ephemeral host port, register the instance for the router once the port is
# known, and deregister on exit.

# Locate the router script: prefer the copy installed next to this launcher.
router_bin() {
    local dir src
    src="${BASH_SOURCE[0]}"
    dir="$(cd "$(dirname "$src")" && pwd)"
    if [ -x "$dir/claude-container-router" ]; then
        printf '%s\n' "$dir/claude-container-router"
    elif command -v claude-container-router >/dev/null 2>&1; then
        command -v claude-container-router
    fi
    return 0
}

registry_field() {
    python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2], ""))' "$1" "$2" 2>/dev/null
    return 0
}

# Instance name for URLs: the workspace basename, plus a short path hash only
# when a different workspace already registered the plain name.
service_instance_name() {
    local base name ws
    base=$(basename "$WORKSPACE_DIR" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-' | sed 's/^-*//; s/-*$//')
    [ -n "$base" ] || base="workspace"
    name="$base"
    if [ -f "$SERVICES_DIR/$name.json" ]; then
        ws="$(registry_field "$SERVICES_DIR/$name.json" workspace)"
        if [ -n "$ws" ] && [ "$ws" != "$WORKSPACE_DIR" ]; then
            name="$base-$(printf '%s' "$WORKSPACE_DIR" | sha256_12 | cut -c1-6)"
        fi
    fi
    printf '%s\n' "$name"
}

# Register this launch in the background: wait for docker to assign the mux's
# ephemeral host port, prune registrations whose containers are gone, write the
# registry entry, and make sure the router is up. Best-effort throughout — a
# missing python3 or router never blocks the launch.
register_services_async() {
    if ! command -v python3 >/dev/null 2>&1; then
        return 0
    fi
    mkdir -p "$SERVICES_DIR"
    (
        mux_port=""
        for _ in $(seq 1 60); do
            mux_port=$(docker port "$CC_CONTAINER_NAME" "${MUX_CONTAINER_PORT}/tcp" 2>/dev/null | head -1)
            mux_port="${mux_port##*:}"
            if [ -n "$mux_port" ]; then
                break
            fi
            sleep 0.5
        done
        if [ -z "$mux_port" ]; then
            exit 0
        fi
        running=$(docker ps --format '{{.Names}}')
        for reg in "$SERVICES_DIR"/*.json; do
            [ -f "$reg" ] || continue
            c="$(registry_field "$reg" container)"
            if [ -n "$c" ] && ! printf '%s\n' "$running" | grep -qx "$c"; then
                rm -f "$reg"
            fi
        done
        CC_REG_FILE="$SERVICES_DIR/$SERVICE_INSTANCE.json" \
        CC_REG_NAME="$SERVICE_INSTANCE" \
        CC_REG_WS="$WORKSPACE_DIR" \
        CC_REG_CONTAINER="$CC_CONTAINER_NAME" \
        CC_REG_PORT="$mux_port" \
        python3 - <<'PY'
import json, os, time
path = os.environ["CC_REG_FILE"]
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump({
        "name": os.environ["CC_REG_NAME"],
        "workspace": os.environ["CC_REG_WS"],
        "container": os.environ["CC_REG_CONTAINER"],
        "mux_port": int(os.environ["CC_REG_PORT"]),
        "started": int(time.time()),
    }, f, indent=2)
    f.write("\n")
os.replace(tmp, path)
PY
        rb="$(router_bin)"
        if [ -n "$rb" ]; then
            CLAUDE_CONTAINER_CONFIG_BASE="$CONFIG_BASE_DIR" "$rb" ensure >/dev/null 2>&1 || true
        fi
    ) &
    REGISTER_PID=$!
    return 0
}

# Remove this launch's registry entry (only if it is still ours — a newer
# launch from the same workspace may have overwritten it). Stops the background
# registration first so a container that exited immediately doesn't get
# registered after the fact; the launch-time prune is the backstop for any
# entry that slips through.
deregister_services() {
    if [ -n "${REGISTER_PID:-}" ]; then
        kill "$REGISTER_PID" 2>/dev/null || true
        wait "$REGISTER_PID" 2>/dev/null || true
    fi
    local reg="$SERVICES_DIR/$SERVICE_INSTANCE.json"
    if [ -z "$SERVICE_INSTANCE" ] || [ ! -f "$reg" ]; then
        return 0
    fi
    if [ "$(registry_field "$reg" container)" = "$CC_CONTAINER_NAME" ]; then
        rm -f "$reg"
    fi
    return 0
}

# --- Host services (design §5.4, §6) ------------------------------------------
#
# A host service is a HOST process the container reaches by name — the mirror of
# the in-container `services`. The launcher starts it before the container,
# health-checks it, restarts per policy, and stops it on exit, so a bridge like
# host-deploy's watcher no longer has to be started by hand. Two transports:
#   * mount — communication is over the shared repo mount (no port); the launcher
#     just supervises the process and watches a heartbeat file.
#   * tcp   — the process listens on a host port; the launcher allocates/validates
#     it, injects a discovery env var (`expose`) = host.docker.internal:<port>,
#     and maps host.docker.internal so the container can reach it.
# The host-exec allowlist (HOST_EXEC_ALLOW_FILE) is the single control that stops
# an adopted skill from launching host processes the user did not permit.

host_exec_seed_policy() {
    [ -f "$HOST_EXEC_ALLOW_FILE" ] && return 0
    mkdir -p "$(dirname "$HOST_EXEC_ALLOW_FILE")"
    cat > "$HOST_EXEC_ALLOW_FILE" <<'EOF'
# claude-container host-exec allowlist. One program name per line: a host service
# (declared by a skill manifest's "hostServices" or a project overlay.json) may
# only launch a program whose name (argv[0] basename) appears here. This is the
# host-exec control — remove entries to tighten, add to permit. The exact start
# command of every host service is also shown in the skill's consent diff.
python3
python
bazel
bazelisk
nix
git
EOF
}

host_exec_allowed() {
    host_exec_seed_policy
    grep -qxF "$1" "$HOST_EXEC_ALLOW_FILE" 2>/dev/null
}

# Emit CC_HS_SOURCES for collect_host_services: project overlay.json + each
# active skill manifest, each tagged with the dir the service's script resolves
# against (the skill dir, or the repo for a project-declared service).
build_host_service_sources() {
    {
        if [ -f "$OVERLAY_PATH/overlay.json" ]; then
            printf 'overlay\tproject overlay.json\t%s\t%s\n' "$OVERLAY_PATH/overlay.json" "$WORKSPACE_DIR"
        fi
        while IFS=$'\t' read -r hs_name hs_dir; do
            [ -n "$hs_name" ] || continue
            [ -f "$hs_dir/$SKILL_MANIFEST_FILE" ] && \
                printf "manifest\tskill '%s'\t%s\t%s\n" "$hs_name" "$hs_dir/$SKILL_MANIFEST_FILE" "$hs_dir"
        done < <(active_skills)
    } | python3 -c 'import sys, json; print(json.dumps([
        {"kind": k, "label": l, "path": p, "dir": d}
        for k, l, p, d in (ln.rstrip("\n").split("\t") for ln in sys.stdin if ln.strip())
    ]))'
}

# Resolve host service declarations across all sources into tab records:
#   name  transport  restart  cwd  healthcheck  port  expose  requires_csv  dir  argv_json
# with $REPO_ROOT/$PORT substituted, tcp ports allocated, and script-filename
# argv tokens rewritten to absolute paths in the skill dir. A service name
# claimed by two sources is a fatal error (exit 3), naming both.
collect_host_services() {
    python3 - <<'PY'
import json, os, shlex, socket, sys

sources = json.loads(os.environ.get("CC_HS_SOURCES", "[]"))
repo = os.environ.get("CC_REPO_ROOT", "")


def fatal(msg):
    print(f"Error: {msg}", file=sys.stderr)
    sys.exit(3)


def warn(msg):
    print(f"Warning: {msg}", file=sys.stderr)


def free_port():
    s = socket.socket()
    s.bind(("127.0.0.1", 0))
    p = s.getsockname()[1]
    s.close()
    return p


seen = {}
recs = []
for src in sources:
    label, kind, d = src.get("label"), src.get("kind"), src.get("dir") or ""
    try:
        data = json.load(open(src["path"]))
    except FileNotFoundError:
        continue
    except Exception as exc:
        warn(f"{label}: could not parse: {exc}")
        continue
    if not isinstance(data, dict):
        continue
    hs = data.get("hostServices") or {}
    if not isinstance(hs, dict):
        warn(f'{label}: "hostServices" must be an object; ignoring it.')
        continue
    for name, spec in hs.items():
        if name in seen:
            fatal(f'host service "{name}" declared by two sources: {seen[name]} and {label}.')
        seen[name] = label
        if not isinstance(spec, dict):
            warn(f'{label}: host service "{name}" must be an object; ignoring it.')
            continue
        start = spec.get("start")
        if not isinstance(start, str) or not start.strip():
            warn(f'{label}: host service "{name}" has no "start"; ignoring it.')
            continue
        transport = spec.get("transport", "mount")
        if transport not in ("mount", "tcp"):
            warn(f'{label}: host service "{name}" has bad transport {transport!r}; using mount.')
            transport = "mount"
        restart = spec.get("restart", "on-failure")
        if restart not in ("never", "on-failure", "always"):
            restart = "on-failure"
        cwd = (spec.get("cwd") or "$REPO_ROOT").replace("${REPO_ROOT}", repo).replace("$REPO_ROOT", repo)
        if not cwd:
            cwd = repo
        port = ""
        if transport == "tcp":
            p = spec.get("port", "auto")
            port = str(free_port()) if p in (None, "auto", "") else str(p)
        argv = []
        for i, tok in enumerate(shlex.split(start)):
            if port:
                tok = tok.replace("${PORT}", port).replace("$PORT", port)
            if i > 0 and d and os.path.exists(os.path.join(d, tok)):
                tok = os.path.abspath(os.path.join(d, tok))
            argv.append(tok)
        hc = (spec.get("healthcheck") or "")
        if port:
            hc = hc.replace("${PORT}", port).replace("$PORT", port)
        expose = spec.get("expose") or ""
        req = spec.get("requires") or []
        if isinstance(req, str):
            req = [req]
        recs.append([name, transport, restart, cwd, hc, port, expose,
                     ",".join(map(str, req)), d, json.dumps(argv)])

# Records are joined with US (\x1f), NOT tab: tab is IFS whitespace, so bash read
# would collapse the empty middle fields (no healthcheck/port/expose) and shift
# the columns. A non-whitespace separator keeps empty fields intact.
for r in recs:
    print("\x1f".join(r))
PY
}

# Per-service background supervisor: (re)start the process per its restart policy
# until the stop flag appears, then reap it. The child runs in its own process
# group so a kill reaps its whole tree; CC_HOST_SERVICE_ROOT tells a repo-rooted
# watcher (e.g. hostdeploy.py) where the shared mailbox lives.
_host_service_supervisor() {
    local sd="$1" stopflag="$2"
    local cwd restart root child rc
    cwd="$(cat "$sd/cwd")"; restart="$(cat "$sd/restart")"; root="$(cat "$sd/root")"
    local -a argv=()
    while IFS= read -r a; do argv+=("$a"); done < "$sd/argv"
    [ ${#argv[@]} -gt 0 ] || return 0
    while [ ! -f "$stopflag" ]; do
        ( cd "$cwd" 2>/dev/null && exec env CC_HOST_SERVICE_ROOT="$root" "${argv[@]}" ) >>"$sd/log" 2>&1 &
        child=$!
        echo "$child" > "$sd/pid"
        while kill -0 "$child" 2>/dev/null; do
            if [ -f "$stopflag" ]; then
                kill -TERM "$child" 2>/dev/null
                break
            fi
            sleep 0.5
        done
        wait "$child" 2>/dev/null; rc=$?
        [ -f "$stopflag" ] && break
        case "$restart" in
            never) break ;;
            on-failure) [ "$rc" -eq 0 ] && break ;;
            always) : ;;
        esac
        sleep 1
    done
    return 0
}

# Best-effort readiness probe (non-fatal): a mount service is healthy once its
# heartbeat file appears; a tcp service once its healthcheck URL answers.
host_service_healthcheck() {
    local name="$1" transport="$2" cwd="$3" hc="$4" i f
    [ -n "$hc" ] || return 0
    if [ "$transport" = "mount" ]; then
        case "$hc" in /*) f="$hc" ;; *) f="$cwd/$hc" ;; esac
        for i in $(seq 1 16); do
            [ -e "$f" ] && { echo -e "${GREEN}  '$name' is up${NC} (heartbeat $f)"; return 0; }
            sleep 0.5
        done
        echo -e "${YELLOW}  '$name' has not reported healthy within 8s (supervision continues; see its log).${NC}"
    else
        command -v curl >/dev/null 2>&1 || return 0
        for i in $(seq 1 16); do
            curl -fsS -o /dev/null "$hc" 2>/dev/null && { echo -e "${GREEN}  '$name' is up${NC} ($hc)"; return 0; }
            sleep 0.5
        done
        echo -e "${YELLOW}  '$name' health check did not pass within 8s ($hc).${NC}"
    fi
    return 0
}

# Start and supervise every declared host service. Skips one whose program is not
# in the host-exec allowlist or whose host `requires` are missing (both warn).
# For tcp services, injects the discovery env var and maps host.docker.internal.
start_host_services() {
    command -v python3 >/dev/null 2>&1 || return 0
    local sources out
    sources="$(build_host_service_sources)"
    [ -n "$sources" ] && [ "$sources" != "[]" ] || return 0
    if ! out="$(CC_HS_SOURCES="$sources" CC_REPO_ROOT="$WORKSPACE_DIR" collect_host_services)"; then
        echo -e "${RED}Error: conflicting host service declarations across the project overlay and its skills.${NC}"
        exit 1
    fi
    [ -n "$out" ] || return 0
    HOST_SVC_RUN_DIR="$CONFIG_BASE_DIR/host-services/$$"
    HOST_SVC_STOPFLAG="$HOST_SVC_RUN_DIR/.stop"
    mkdir -p "$HOST_SVC_RUN_DIR"
    local name transport restart cwd healthcheck port expose requires dir argv_json
    while IFS=$'\x1f' read -r name transport restart cwd healthcheck port expose requires dir argv_json; do
        [ -n "$name" ] || continue
        local -a argv=()
        while IFS= read -r tok; do argv+=("$tok"); done \
            < <(printf '%s' "$argv_json" | python3 -c 'import sys, json; [print(t) for t in json.load(sys.stdin)]')
        [ ${#argv[@]} -gt 0 ] || continue
        local prog; prog="$(basename "${argv[0]}")"
        if ! host_exec_allowed "$prog"; then
            echo -e "${YELLOW}Host service '$name' NOT started: '$prog' is not in the host-exec allowlist${NC}"
            echo -e "${YELLOW}  (${HOST_EXEC_ALLOW_FILE}). Add it there to permit this host command.${NC}"
            continue
        fi
        local missing="" t
        for t in ${requires//,/ }; do
            [ -n "$t" ] && ! command -v "$t" >/dev/null 2>&1 && missing="$missing $t"
        done
        if [ -n "$missing" ]; then
            echo -e "${YELLOW}Host service '$name' NOT started: missing host tool(s):$missing.${NC}"
            continue
        fi
        if [ "$transport" = "tcp" ] && [ -n "$port" ]; then
            [ -n "$expose" ] && EXTRA_DOCKER_ARGS+=(-e "$expose=host.docker.internal:$port")
            case " ${EXTRA_DOCKER_ARGS[*]-} " in
                *" host.docker.internal:host-gateway "*) : ;;
                *) EXTRA_DOCKER_ARGS+=(--add-host "host.docker.internal:host-gateway") ;;
            esac
        fi
        local sd="$HOST_SVC_RUN_DIR/$name"; mkdir -p "$sd"
        printf '%s\n' "${argv[@]}" > "$sd/argv"
        printf '%s' "$cwd" > "$sd/cwd"
        printf '%s' "$restart" > "$sd/restart"
        printf '%s' "$WORKSPACE_DIR" > "$sd/root"
        : > "$sd/log"
        _host_service_supervisor "$sd" "$HOST_SVC_STOPFLAG" &
        HOST_SVC_SUPERVISORS+=($!)
        if [ "$transport" = "tcp" ] && [ -n "$expose" ]; then
            echo -e "${GREEN}Host service:${NC} ${YELLOW}${name}${NC} (tcp, ${expose}=host.docker.internal:${port})"
        else
            echo -e "${GREEN}Host service:${NC} ${YELLOW}${name}${NC} (${transport})"
        fi
        host_service_healthcheck "$name" "$transport" "$cwd" "$healthcheck"
    done <<EOF_HS
$out
EOF_HS
    return 0
}

stop_host_services() {
    [ -n "$HOST_SVC_STOPFLAG" ] || return 0
    : > "$HOST_SVC_STOPFLAG" 2>/dev/null || true
    local pid sd
    for pid in ${HOST_SVC_SUPERVISORS[@]+"${HOST_SVC_SUPERVISORS[@]}"}; do
        kill "$pid" 2>/dev/null || true
    done
    if [ -n "$HOST_SVC_RUN_DIR" ] && [ -d "$HOST_SVC_RUN_DIR" ]; then
        for sd in "$HOST_SVC_RUN_DIR"/*/; do
            [ -f "$sd/pid" ] && kill "$(cat "$sd/pid")" 2>/dev/null || true
        done
        rm -rf "$HOST_SVC_RUN_DIR"
    fi
    return 0
}

# Function to stop datasette
stop_datasette() {
    if docker ps -a --format '{{.Names}}' | grep -q "^${DATASETTE_CONTAINER_NAME}$"; then
        echo -e "${YELLOW}Stopping Datasette container...${NC}"
        docker stop "$DATASETTE_CONTAINER_NAME" 2>/dev/null || true
        docker rm "$DATASETTE_CONTAINER_NAME" 2>/dev/null || true
    fi
}

# Function to stop proxy
stop_proxy() {
    if docker ps -a --format '{{.Names}}' | grep -q "^${PROXY_CONTAINER_NAME}$"; then
        echo -e "${YELLOW}Stopping proxy container...${NC}"
        docker stop "$PROXY_CONTAINER_NAME" 2>/dev/null || true
        docker rm "$PROXY_CONTAINER_NAME" 2>/dev/null || true
    fi

    if docker network ls --format '{{.Name}}' | grep -q "^${NETWORK_NAME}$"; then
        # Check if network has any containers
        if [ -z "$(docker network inspect "$NETWORK_NAME" -f '{{range .Containers}}{{.Name}}{{end}}' 2>/dev/null)" ]; then
            echo -e "${YELLOW}Removing network...${NC}"
            docker network rm "$NETWORK_NAME" 2>/dev/null || true
        fi
    fi
}

# Function to start proxy
start_proxy() {
    # Create network if it doesn't exist
    if ! docker network ls --format '{{.Name}}' | grep -q "^${NETWORK_NAME}$"; then
        echo -e "${GREEN}Creating Docker network...${NC}"
        docker network create "$NETWORK_NAME"
    fi

    # Check if proxy is already running
    if docker ps --format '{{.Names}}' | grep -q "^${PROXY_CONTAINER_NAME}$"; then
        echo -e "${BLUE}Proxy is already running${NC}"
        return 0
    fi

    # Remove stopped proxy container if exists
    if docker ps -a --format '{{.Names}}' | grep -q "^${PROXY_CONTAINER_NAME}$"; then
        docker rm "$PROXY_CONTAINER_NAME" 2>/dev/null || true
    fi

    # Create proxy data directory if it doesn't exist
    if [ ! -d "$PROXY_DATA_DIR" ]; then
        echo -e "${YELLOW}Creating proxy data directory: $PROXY_DATA_DIR${NC}"
        mkdir -p "$PROXY_DATA_DIR"
    fi

    # Start proxy container
    echo -e "${GREEN}Starting proxy container...${NC}"
    docker run -d \
        --name "$PROXY_CONTAINER_NAME" \
        --network "$NETWORK_NAME" \
        -v "$PROXY_DATA_DIR:/data" \
        "$PROXY_IMAGE"

    echo -e "${GREEN}Proxy started successfully${NC}"
    echo -e "Proxy logs: ${YELLOW}$PROXY_DATA_DIR/requests.db${NC}"
}

# Function to start datasette
start_datasette() {
    local standalone="${1:-false}"

    # Check if datasette is already running
    if docker ps --format '{{.Names}}' | grep -q "^${DATASETTE_CONTAINER_NAME}$"; then
        echo -e "${BLUE}Datasette is already running at http://localhost:${DATASETTE_PORT}${NC}"
        return 0
    fi

    # In standalone mode, check if database exists
    if [ "$standalone" = "true" ]; then
        if [ ! -f "$PROXY_DATA_DIR/requests.db" ]; then
            echo -e "${RED}Error: Database not found at $PROXY_DATA_DIR/requests.db${NC}"
            echo -e "${YELLOW}Run Claude Code with --proxy first to create the database${NC}"
            exit 1
        fi
        echo -e "${GREEN}Starting Datasette in standalone mode...${NC}"
    else
        # In integrated mode, ensure proxy is running
        if ! docker ps --format '{{.Names}}' | grep -q "^${PROXY_CONTAINER_NAME}$"; then
            echo -e "${RED}Error: Datasette requires the proxy to be running${NC}"
            echo -e "${YELLOW}Use --proxy flag to enable the proxy${NC}"
            exit 1
        fi
    fi

    # Remove stopped datasette container if exists
    if docker ps -a --format '{{.Names}}' | grep -q "^${DATASETTE_CONTAINER_NAME}$"; then
        docker rm "$DATASETTE_CONTAINER_NAME" 2>/dev/null || true
    fi

    # Start datasette container
    # In standalone mode, no network needed; in integrated mode, use the network
    if [ "$standalone" = "true" ]; then
        echo -e "${GREEN}Starting Datasette container...${NC}"
        docker run -d \
            --name "$DATASETTE_CONTAINER_NAME" \
            -v "$PROXY_DATA_DIR:/data:ro" \
            -p "${DATASETTE_PORT}:8001" \
            "$DATASETTE_IMAGE"
    else
        echo -e "${GREEN}Starting Datasette container...${NC}"
        docker run -d \
            --name "$DATASETTE_CONTAINER_NAME" \
            --network "$NETWORK_NAME" \
            -v "$PROXY_DATA_DIR:/data:ro" \
            -p "${DATASETTE_PORT}:8001" \
            "$DATASETTE_IMAGE"
    fi

    echo -e "${GREEN}Datasette started successfully${NC}"
    echo -e "Web UI: ${YELLOW}http://localhost:${DATASETTE_PORT}${NC}"
}

# Function to cleanup on exit
cleanup() {
    local exit_code=$?
    deregister_services
    stop_host_services
    if [ $exit_code -ne 0 ] && [ "$USE_PROXY" = true ]; then
        echo -e "\n${YELLOW}Error occurred. Cleaning up...${NC}"
        stop_proxy
    fi
}

# Parse command line arguments
STOP_PROXY=false
STOP_DATASETTE=false
SHOW_LOGS=false
SHOW_DATASETTE_LOGS=false
PULL_IMAGES=false
DATASETTE_ONLY=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        -w|--workspace)
            WORKSPACE_DIR="$2"
            shift 2
            ;;
        -c|--config)
            CONFIG_DIR="$2"
            shift 2
            ;;
        --proxy)
            USE_PROXY=true
            shift
            ;;
        --proxy-data)
            PROXY_DATA_DIR="$2"
            shift 2
            ;;
        --proxy-stop)
            STOP_PROXY=true
            shift
            ;;
        --proxy-logs)
            SHOW_LOGS=true
            shift
            ;;
        --datasette)
            USE_DATASETTE=true
            USE_PROXY=true  # Datasette requires proxy
            shift
            ;;
        --datasette-only)
            DATASETTE_ONLY=true
            shift
            ;;
        --datasette-port)
            DATASETTE_PORT="$2"
            shift 2
            ;;
        --datasette-stop)
            STOP_DATASETTE=true
            shift
            ;;
        --datasette-logs)
            SHOW_DATASETTE_LOGS=true
            shift
            ;;
        --services)
            ROUTER_ACTION="services"
            shift
            ;;
        --service-port)
            if [ -z "${2:-}" ] || [[ "$2" == -* ]]; then
                echo -e "${RED}Error: --service-port requires <instance>/<service>${NC}"
                exit 1
            fi
            ROUTER_ACTION="port"
            SERVICE_PORT_SPEC="$2"
            shift 2
            ;;
        --router-start)
            ROUTER_ACTION="start"
            shift
            ;;
        --router-stop)
            ROUTER_ACTION="stop"
            shift
            ;;
        --router-status)
            ROUTER_ACTION="status"
            shift
            ;;
        --router-logs)
            ROUTER_ACTION="logs"
            shift
            ;;
        --skills)
            SKILLS_ACTION="list"
            shift
            ;;
        --skills-adopt|--skills-drop|--skills-accept|--skills-reject)
            if [ -z "${2:-}" ] || [[ "$2" == -* ]]; then
                echo -e "${RED}Error: $1 requires a skill name${NC}"
                exit 1
            fi
            SKILLS_ACTION="${1#--skills-}"
            SKILLS_NAME="$2"
            shift 2
            ;;
        --skills-reset)
            SKILLS_ACTION="reset"
            shift
            ;;
        --skills-fragments)
            SKILLS_ACTION="fragments"
            shift
            ;;
        --skills-ignore-new)
            SKILLS_IGNORE_NEW=true
            shift
            ;;
        --pull)
            PULL_IMAGES=true
            shift
            ;;
        --shell)
            SHELL_MODE=true
            shift
            ;;
        --tmux)
            TMUX_MODE=true
            shift
            ;;
        --mount)
            if [ -z "${2:-}" ] || [[ "$2" == -* ]]; then
                echo -e "${RED}Error: --mount requires a host path${NC}"
                exit 1
            fi
            MOUNT_SPECS+=("$2")
            shift 2
            ;;
        -v|--version)
            echo -e "${GREEN}Claude Container Version Information${NC}"
            echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo -e "Claude Container: ${YELLOW}v${VERSION}${NC}"

            # Get Claude Code version from the container
            # Try to extract version, handle both formats: "vX.Y.Z" and "X.Y.Z"
            CLAUDE_VERSION=$(docker run --rm "$IMAGE" claude --version 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
            if [ -z "$CLAUDE_VERSION" ]; then
                CLAUDE_VERSION="unknown"
            else
                CLAUDE_VERSION="v${CLAUDE_VERSION}"
            fi
            echo -e "Claude Code:      ${YELLOW}${CLAUDE_VERSION}${NC}"

            # Get Docker version
            DOCKER_VERSION=$(docker --version 2>/dev/null | grep -oP '\d+\.\d+\.\d+' | head -1 || echo "unknown")
            echo -e "Docker:           ${YELLOW}${DOCKER_VERSION}${NC}"
            echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            exit 0
            ;;
        *)
            # Treat remaining arguments as command to run
            COMMAND="$@"
            break
            ;;
    esac
done

# Override with environment variables if set
WORKSPACE_DIR="${CLAUDE_WORKSPACE:-$WORKSPACE_DIR}"
CONFIG_DIR="${CLAUDE_CONFIG:-$CONFIG_DIR}"
PROXY_DATA_DIR="${CLAUDE_PROXY_DATA:-$PROXY_DATA_DIR}"
IMAGE="${CLAUDE_IMAGE:-$IMAGE}"
PROXY_IMAGE="${CLAUDE_PROXY_IMAGE:-$PROXY_IMAGE}"
DATASETTE_IMAGE="${CLAUDE_DATASETTE_IMAGE:-$DATASETTE_IMAGE}"

# Handle service router commands (host-side; no container involved).
if [ -n "$ROUTER_ACTION" ]; then
    ROUTER="$(router_bin)"
    if [ -z "$ROUTER" ]; then
        echo -e "${RED}Error: claude-container-router not found (expected next to this script or on PATH).${NC}"
        echo -e "${YELLOW}Re-run ./install.sh from the repo checkout to install it.${NC}"
        exit 1
    fi
    export CLAUDE_CONTAINER_CONFIG_BASE="$CONFIG_BASE_DIR"
    case "$ROUTER_ACTION" in
        start)    exec "$ROUTER" ensure ;;
        stop)     exec "$ROUTER" stop ;;
        status)   exec "$ROUTER" status ;;
        services) exec "$ROUTER" services ;;
        port)     exec "$ROUTER" port "$SERVICE_PORT_SPEC" ;;
        logs)
            if [ ! -f "$CONFIG_BASE_DIR/router.log" ]; then
                echo -e "${RED}Error: no router log at $CONFIG_BASE_DIR/router.log${NC}"
                exit 1
            fi
            exec tail -f "$CONFIG_BASE_DIR/router.log"
            ;;
    esac
fi

# Handle skill management commands (host-side; no container involved).
if [ -n "$SKILLS_ACTION" ]; then

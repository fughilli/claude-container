        drop)   skills_drop "$SKILLS_NAME" ;;
        accept) skills_set_project_choice "$SKILLS_NAME" accept ;;
        reject) skills_set_project_choice "$SKILLS_NAME" reject ;;
        reset)  skills_reset ;;
        fragments) skills_fragments ;;
    esac
    exit 0
fi

# Handle shell mode - override command to drop into shell
if [ "$SHELL_MODE" = true ]; then
    COMMAND="/bin/sh"
fi

# Handle tmux mode - run the resolved command inside a named tmux session. This
# lets the user open additional shells in the container (their tmux prefix + c)
# without going through Claude, and lets Claude drive/observe extra windows via
# `tmux` / `tmux send-keys`. The session name is canonical (see the container-tmux
# skill). The host's ~/.tmux.conf is mounted in when present.
if [ "$TMUX_MODE" = true ]; then
    EXTRA_DOCKER_ARGS+=(-e "CLAUDE_TMUX_COMMAND=$COMMAND")
    if [ -f "$HOME/.tmux.conf" ]; then
        EXTRA_DOCKER_ARGS+=(-v "$HOME/.tmux.conf:/etc/claude-container/tmux.conf:ro")
    else
        echo -e "${YELLOW}No ~/.tmux.conf found on host; using tmux defaults.${NC}"
    fi
    COMMAND="claude-tmux"
fi

# Handle datasette-only command
if [ "$DATASETTE_ONLY" = true ]; then
    # Convert proxy data dir to absolute path
    PROXY_DATA_DIR="$(cd "$(dirname "$PROXY_DATA_DIR")" 2>/dev/null && pwd)/$(basename "$PROXY_DATA_DIR")" || PROXY_DATA_DIR="$(pwd)/$(basename "$PROXY_DATA_DIR")"

    if [ ! -d "$PROXY_DATA_DIR" ]; then

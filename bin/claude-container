# Overlay support: .claude-container-overlay at the workspace root layers
# project-specific state on top of the shared base image.
#
# Directory form (canonical):
#   .claude-container-overlay/
#   ├── Dockerfile      build fragment appended to the base image; the overlay
#   │                   directory is the docker build context, so COPY works
#   ├── overlay.json    structured runtime config, e.g. {"ports": ["8080:8080"]}
#   └── skills/<name>/  skills proposed from inside the container — deployed at
#                       launch by sync_skills above, never baked into the image
#
# Legacy form (still supported): a single Dockerfile-fragment file with
# `# claude-container:port <mapping>` directive comments for port mappings.
#
# The overlay image is tagged with a content hash of (base image + build inputs)
# so switching branches that have different overlays just switches images.
# Runtime-only inputs (overlay.json, startup.sh, skills/) are excluded from the
# hash, so changing ports, runtime flags, the startup hook or skills never
# triggers a rebuild.
# Fold the allowlisted runtime keys of the project overlay.json AND each active
# skill manifest's "runtime" block into one effective set of docker run flags,
# emitting tagged lines: "RTARG<TAB>token" (--cap-add/--device/--sysctl/-e
# tokens, one per line) and "PORT<TAB>mapping" (a -p value). Sources are read
# from CC_SOURCES, a JSON array of {kind: overlay|manifest, label, path}.
#
# The merge is a UNION with conflict detection (design §5.2):
#   * capabilities/devices  -> set union (deduped)
#   * env                   -> union by name (values still come from the host
#                              environment at run time; the manifest only names
#                              them). A by-name and a NAME=value form, or two
#                              differing literals, for the SAME name conflict.
#   * sysctls / ports / services -> union; the SAME key/host-port/name claimed
#                              with a DIFFERENT value by two sources is a fatal
#                              error naming both claimants — never silently pick.
# A genuine cross-source conflict exits non-zero so the launcher fails loudly at
# launch. Malformed *entries* (bad names, host-wide sysctls) are warned and
# skipped, exactly as before, so one bad entry never takes the launch down.
#
# Kept in a function because the parser is a heredoc: bash 3.2 (macOS's system
# bash) looks for the closing paren of a process substitution without skipping
# heredoc bodies, so inlining it under <(...) fails to parse there.
overlay_runtime_merge() {
    python3 - <<'PY'
import json, os, re, sys

sources = json.loads(os.environ.get("CC_SOURCES", "[]"))
FATAL = 3


def warn(label, msg):
    print(f"Warning: {label}: {msg}", file=sys.stderr)


def fatal(msg):
    print(f"Error: {msg}", file=sys.stderr)
    sys.exit(FATAL)


def as_list(value, key, label):
    """Accept a bare string as a one-element list, like "ports" does."""
    if value is None:
        return []
    if isinstance(value, str):
        return [value]
    if isinstance(value, list):
        return value
    warn(label, f'"{key}" must be a list; ignoring it.')
    return []


SYSCTL_PREFIXES = ("net.", "fs.mqueue.", "kernel.msg", "kernel.sem", "kernel.shm")

out = []            # ("RTARG", token) / ("PORT", mapping) in emission order
caps = set()        # deduped capability names
devices = set()     # deduped device specs
env_seen = {}       # name -> ("byname",) | ("literal", value)  [+ label]
env_unset = set()   # names warned as unset (warn once)
sysctls = {}        # name -> (value_str, label)
ports = {}          # host-port key -> (mapping, label)
services = {}       # service name -> label


def host_port_key(mapping):
    """The host port a -p mapping pins, or None when docker assigns one (a bare
    container port). Forms: cont | host:cont | ip:host:cont, optional /proto."""
    m = mapping.strip()
    proto = ""
    if "/" in m:
        m, proto = m.rsplit("/", 1)
    parts = m.split(":")
    if len(parts) == 1:
        return None
    hp = parts[0] if len(parts) == 2 else parts[-2]
    hp = hp.strip()
    return f"{hp}/{proto}" if hp else None


for src in sources:
    label = src.get("label", "overlay.json")
    kind = src.get("kind", "overlay")
    try:
        with open(src["path"]) as f:
            data = json.load(f)
    except FileNotFoundError:
        continue
    except Exception as exc:
        warn(label, f"could not parse: {exc}")
        continue
    if not isinstance(data, dict):
        continue
    block = data.get("runtime", {}) if kind == "manifest" else data
    if not isinstance(block, dict):
        warn(label, '"runtime" must be an object; ignoring it.')
        continue

    for cap in as_list(block.get("capabilities", []), "capabilities", label):
        if not isinstance(cap, str):
            warn(label, f"ignoring non-string capability {cap!r}.")
            continue
        name = cap.strip().upper()
        if name in ("ALL", "CAP_ALL"):
            warn(label, 'refusing "ALL" in "capabilities" — list the specific capabilities the project needs.')
            continue
        if not re.fullmatch(r"(CAP_)?[A-Z0-9_]+", name):
            warn(label, f"ignoring malformed capability {cap!r}.")
            continue
        if name in caps:
            continue
        caps.add(name)
        out += [("RTARG", "--cap-add"), ("RTARG", name)]

    for dev in as_list(block.get("devices", []), "devices", label):
        if not isinstance(dev, str):
            warn(label, f"ignoring non-string device {dev!r}.")
            continue
        spec = dev.strip()
        parts = spec.split(":")
        if len(parts) > 3:
            warn(label, f"ignoring malformed device {dev!r} (expected host[:container[:perms]]).")
            continue
        # Both the host and container paths must name a device node, so a device
        # entry can't be repurposed into a bind mount of an arbitrary host path.
        bad = [p for p in parts[:2] if not p.startswith("/dev/") or ".." in p.split("/")]
        if bad:
            warn(label, f"ignoring device {dev!r} — paths must be under /dev/ and free of '..'.")
            continue
        if len(parts) == 3 and not re.fullmatch(r"[rwm]{1,3}", parts[2]):
            warn(label, f"ignoring device {dev!r} — permissions must be a combination of r, w and m.")
            continue
        if spec in devices:
            continue
        devices.add(spec)
        out += [("RTARG", "--device"), ("RTARG", spec)]

    # Docker only permits sysctls that are namespaced to the container; anything
    # else would be a host-wide setting and is rejected by the daemon anyway.
    sysctl_block = block.get("sysctls", {})
    if not isinstance(sysctl_block, dict):
        warn(label, '"sysctls" must be an object of name -> value; ignoring it.')
        sysctl_block = {}
    for name, value in sysctl_block.items():
        if not isinstance(name, str) or not name.startswith(SYSCTL_PREFIXES):
            warn(label, f"ignoring sysctl {name!r} — only container-namespaced sysctls are allowed "
                        f"({', '.join(SYSCTL_PREFIXES)}).")
            continue
        if isinstance(value, bool) or not isinstance(value, (str, int, float)):
            warn(label, f"ignoring sysctl {name!r} — value must be a string or number.")
            continue
        sval = f"{value}"
        if name in sysctls:
            if sysctls[name][0] != sval:
                fatal(f'sysctl "{name}" set to conflicting values: '
                      f"{sysctls[name][0]!r} by {sysctls[name][1]}, {sval!r} by {label}.")
            continue
        sysctls[name] = (sval, label)
        out += [("RTARG", "--sysctl"), ("RTARG", f"{name}={sval}")]

    for entry in as_list(block.get("env", []), "env", label):
        if not isinstance(entry, str):
            warn(label, f"ignoring non-string env entry {entry!r}.")
            continue
        name, sep, _ = entry.strip().partition("=")
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
            warn(label, f"ignoring malformed env entry {entry!r}.")
            continue
        spec = ("literal", entry.strip()) if sep else ("byname",)
        if name in env_seen:
            if env_seen[name][0] != spec:
                fatal(f'env "{name}" declared incompatibly by two sources '
                      f"(last: {label}); reconcile them.")
            continue
        if sep:
            env_seen[name] = (spec, label)
            out += [("RTARG", "-e"), ("RTARG", entry.strip())]
        elif name in os.environ:
            env_seen[name] = (spec, label)
            out += [("RTARG", "-e"), ("RTARG", name)]
        elif name not in env_unset:
            env_unset.add(name)
            warn(label, f'"{name}" is declared in "env" but is unset in the launching environment; '
                        f"the container will not see it.")

    for port in as_list(block.get("ports", []), "ports", label):
        if not isinstance(port, str) or not port.strip():
            continue
        mapping = port.strip()
        key = host_port_key(mapping)
        if key is not None and key in ports:
            if ports[key][0] != mapping:
                fatal(f"host port {key.rstrip('/')} claimed by two sources: "
                      f"{ports[key][0]!r} ({ports[key][1]}) and {mapping!r} ({label}).")
            continue
        if key is not None:
            ports[key] = (mapping, label)
        out.append(("PORT", mapping))

    svc_block = block.get("services", {})
    if isinstance(svc_block, dict):
        for name in svc_block:
            if name in services and services[name] != label:
                fatal(f'service "{name}" declared by two sources: '
                      f"{services[name]} and {label}.")
            services[name] = label

for tag, val in out:
    print(f"{tag}\t{val}")
PY
}

# Emit CC_SOURCES (a JSON array) for overlay_runtime_merge: the project
# overlay.json, then each active skill's manifest, so the project is the first
# claimant named in any conflict message.
build_runtime_sources() {
    {
        if [ -f "$OVERLAY_PATH/overlay.json" ]; then
            printf 'overlay\tproject overlay.json\t%s\n' "$OVERLAY_PATH/overlay.json"
        fi
        while IFS=$'\t' read -r rt_name rt_dir; do
            [ -n "$rt_name" ] || continue
            if [ -f "$rt_dir/$SKILL_MANIFEST_FILE" ]; then
                printf "manifest\tskill '%s'\t%s\n" "$rt_name" "$rt_dir/$SKILL_MANIFEST_FILE"
            fi
        done < <(active_skills)
    } | python3 -c 'import sys, json; print(json.dumps([
        {"kind": k, "label": l, "path": p}
        for k, l, p in (ln.rstrip("\n").split("\t") for ln in sys.stdin if ln.strip())
    ]))'
}

# Assemble the ordered BOOT drop-in list (design §5.3): the project's startup.sh
# plus each active skill's manifest "container.startup", sorted by "container.
# order" (default 50) then skill name. The scripts are already inside the
# container — sync_skills deployed each skill dir under $CONFIG_DIR/skills (mounted
# at /claude), and the project overlay is the /workspace mount — so we record
# their CONTAINER paths, one per line in order, in $CONFIG_DIR/startup-dropins
# (which the container sees at /claude/startup-dropins). The entrypoint runs them
# in that order. Same-order skills run before the project hook, so a skill that
# stands up a capability (e.g. the tailnet join) is in place first. Writes
# nothing and clears any stale list when there are no drop-ins.
STARTUP_DROPINS_FILE=""
collect_startup_dropins() {
    local out="$CONFIG_DIR/startup-dropins"
    local name dir startup order line
    local -a rows=()
    while IFS=$'\t' read -r name dir; do
        [ -n "$name" ] || continue
        startup="$(skill_manifest_get "$dir" container.startup 2>/dev/null)" || startup=""
        [ -n "$startup" ] || continue
        # A drop-in path escaping the skill dir, or one that isn't actually there,
        # is ignored rather than trusted.
        case "$startup" in /*|*..*) continue ;; esac
        [ -f "$dir/$startup" ] || continue
        order="$(skill_manifest_get "$dir" container.order 2>/dev/null)" || order=""
        case "$order" in ''|*[!0-9]*) order=50 ;; esac
        # kind 0 (skill) sorts before kind 1 (project) at equal order.
        rows+=("$(printf '%s\t0\t%s\t/claude/skills/%s/%s' "$order" "$name" "$name" "$startup")")
    done < <(active_skills)

    if [ -f "$OVERLAY_PATH/startup.sh" ]; then
        rows+=("$(printf '50\t1\t\t/workspace/.claude-container-overlay/startup.sh')")
    fi

    if [ ${#rows[@]} -eq 0 ]; then
        rm -f "$out"
        STARTUP_DROPINS_FILE=""
        return 0
    fi

    mkdir -p "$CONFIG_DIR"
    printf '%s\n' "${rows[@]}" | LC_ALL=C sort -t$'\t' -k1,1n -k2,2n -k3,3 | cut -f4 > "$out"
    STARTUP_DROPINS_FILE="$out"
    local -a shown=()
    while IFS= read -r line; do shown+=("$(basename "$line")"); done < "$out"
    echo -e "${GREEN}Startup drop-ins (in order):${NC} ${YELLOW}${shown[*]}${NC}"
    return 0
}

OVERLAY_PATH="$WORKSPACE_DIR/.claude-container-overlay"
PORT_MAPPINGS=()
OVERLAY_BUILD=""
OVERLAY_CONTEXT=""
if [ -d "$OVERLAY_PATH" ]; then
    if [ -f "$OVERLAY_PATH/Dockerfile" ]; then
        OVERLAY_BUILD="$(cat "$OVERLAY_PATH/Dockerfile")"$'\n'
        OVERLAY_CONTEXT="$OVERLAY_PATH"
    fi
elif [ -f "$OVERLAY_PATH" ]; then
    echo -e "${BLUE}Note: single-file overlays still work, but .claude-container-overlay can now be${NC}"
    echo -e "${BLUE}a directory (Dockerfile + overlay.json + skills/) — see the README.${NC}"
    # Split the legacy overlay into (a) port-forwarding directives and (b) the
    # actual Dockerfile build instructions.
    #
    # Port directives are comments of the form `# claude-container:port <mapping>`
    # where <mapping> is anything docker's -p accepts (8080:8080,
    # 127.0.0.1:3000:3000, 9000:9000/udp, or a bare container port). They are a
    # RUNTIME concern (docker run -p), not a build concern, so we strip them out
    # of OVERLAY_BUILD before hashing and building. That keeps the image hash
    # stable when you only add/change/remove port mappings — no rebuild, the
    # existing overlay image is reused.
    while IFS= read -r overlay_line || [ -n "$overlay_line" ]; do
        if [[ "$overlay_line" =~ ^[[:space:]]*#[[:space:]]*claude-container:[[:space:]]*port[[:space:]]+(.+)$ ]]; then
            port_mapping="${BASH_REMATCH[1]}"
            # Trim trailing whitespace
            port_mapping="${port_mapping%"${port_mapping##*[![:space:]]}"}"
            if [ -n "$port_mapping" ]; then
                PORT_ARGS+=(-p "$port_mapping")
                PORT_MAPPINGS+=("$port_mapping")
            fi
        else
            OVERLAY_BUILD+="$overlay_line"$'\n'
        fi
    done < "$OVERLAY_PATH"
fi

# Runtime docker flags and ports: fold the project overlay.json together with
# each active skill manifest's "runtime" block (design §5.2). Runs even without a
# project overlay dir, so a skill adopted user-wide (e.g. tailnet) contributes
# its capabilities/device/env by itself. Unlike the image fragments, these are
# ALLOWLISTED and validated rather than forwarded verbatim: overlay.json is
# committed with the repo and applied silently at the next launch, so a cloned —
# or agent-written — branch must not reach the host with -v /:/host, --privileged
# or --pid=host. Each key maps to exactly one docker flag:
#
#   "capabilities": ["NET_ADMIN"]               --cap-add NET_ADMIN
#   "devices":      ["/dev/net/tun"]            --device /dev/net/tun
#   "sysctls":      {"net.ipv4.ip_forward": 1}  --sysctl net.ipv4.ip_forward=1
#   "env":          ["TS_AUTHKEY"]              -e TS_AUTHKEY
#
# An "env" entry with no "=" forwards the variable BY NAME, so its value comes
# from the launching environment and never appears in the container's argv (keeps
# secrets out of `ps`). The "NAME=value" form is accepted too, for non-secret
# values. All of these are runtime-only: overlay.json and skill manifests are
# excluded from the image hash, so changing them never triggers a rebuild.
if command -v python3 >/dev/null 2>&1; then
    CC_RT_SOURCES="$(build_runtime_sources)"
    if [ -n "$CC_RT_SOURCES" ] && [ "$CC_RT_SOURCES" != "[]" ]; then
        # Capture instead of piping so array appends land in this shell, and so a
        # conflict (merger exits non-zero, having named both claimants on stderr)
        # fails the launch loudly rather than silently dropping a claim.
        if ! CC_RT_OUT="$(CC_SOURCES="$CC_RT_SOURCES" overlay_runtime_merge)"; then
            echo -e "${RED}Error: conflicting runtime declarations across the project overlay and its skills.${NC}"
            echo -e "${RED}Resolve the conflict above, or reject the offending skill, then relaunch.${NC}"
            exit 1
        fi
        while IFS=$'\t' read -r rt_tag rt_val; do
            [ -n "$rt_tag" ] || continue
            case "$rt_tag" in
                RTARG) OVERLAY_RUNTIME_ARGS+=("$rt_val") ;;
                PORT)  PORT_ARGS+=(-p "$rt_val"); PORT_MAPPINGS+=("$rt_val") ;;
            esac
        done <<EOF_RT
$CC_RT_OUT
EOF_RT
    fi
elif [ -f "$OVERLAY_PATH/overlay.json" ]; then
    echo -e "${YELLOW}Warning: python3 not found; ignoring ports and runtime flags in overlay.json.${NC}"
fi

# Skill-provided fragments go FIRST, so the workspace's own overlay can build on
# what they install. A project with no overlay directory still gets an image
# when a skill contributes one (OVERLAY_CONTEXT stays empty and the build runs
# from a temporary context below).
if [ -n "$SKILL_FRAGMENT_BUILD" ]; then
    OVERLAY_BUILD="$SKILL_FRAGMENT_BUILD$OVERLAY_BUILD"
fi

if [ ${#PORT_MAPPINGS[@]} -gt 0 ]; then
    echo -e "${GREEN}Publishing overlay ports:${NC} ${YELLOW}${PORT_MAPPINGS[*]}${NC}"
fi

if [ ${#OVERLAY_RUNTIME_ARGS[@]} -gt 0 ]; then
    # Mask the value of a literal "-e NAME=value" so a secret written into
    # overlay.json isn't echoed to the terminal. (The by-name form, which is
    # what secrets should use, has no value to mask.)
    RUNTIME_SUMMARY=""
    prev_runtime_arg=""
    for runtime_arg in "${OVERLAY_RUNTIME_ARGS[@]}"; do
        if [ "$prev_runtime_arg" = "-e" ] && [[ "$runtime_arg" == *=* ]]; then
            runtime_arg="${runtime_arg%%=*}=***"
        fi
        RUNTIME_SUMMARY+="${RUNTIME_SUMMARY:+ }$runtime_arg"
        prev_runtime_arg="$runtime_arg"
    done
    echo -e "${GREEN}Overlay runtime flags:${NC} ${YELLOW}${RUNTIME_SUMMARY}${NC}"
fi

# BOOT phase: assemble the ordered startup drop-in list (project startup.sh +
# each active skill's container.startup) and point the entrypoint at it. The
# entrypoint runs each in order, non-fatally, as the mapped user. Recomputed
# every launch so a removed/rejected skill's drop-in falls out.
collect_startup_dropins
if [ -n "$STARTUP_DROPINS_FILE" ]; then
    EXTRA_DOCKER_ARGS+=(-e "CLAUDE_STARTUP_DROPINS=/claude/startup-dropins")
fi

# Named services declared in overlay.json (display only — resolution happens
# live inside the container, so this list can grow mid-session).
SERVICES_DECLARED=""
if [ -f "$OVERLAY_PATH/overlay.json" ] && command -v python3 >/dev/null 2>&1; then
    SERVICES_DECLARED=$(OVERLAY_JSON="$OVERLAY_PATH/overlay.json" python3 - <<'PY'
import json, os
try:
    with open(os.environ["OVERLAY_JSON"]) as f:
        services = json.load(f).get("services", {})
    parts = []
    if isinstance(services, dict):
        for k, v in sorted(services.items()):
            # Bare port, or extended {"port": N, "tls": true}.
            if isinstance(v, dict):
                parts.append(f"{k}:{v.get('port')}{'(tls)' if v.get('tls') else ''}")
            else:
                parts.append(f"{k}:{v}")
    print(" ".join(parts))
except Exception:
    pass
PY
)
fi
if [ -n "$SERVICES_DECLARED" ]; then
    echo -e "${GREEN}Named services:${NC} ${YELLOW}${SERVICES_DECLARED}${NC}"
    ROUTER_HTTP_PORT="${CLAUDE_ROUTER_HTTP_PORT:-8484}"
    echo -e "${GREEN}Reachable at:${NC} ${YELLOW}http://<service>.${SERVICE_INSTANCE}.claude.localhost/${NC} (append :${ROUTER_HTTP_PORT} if port 80 isn't bound; exact URLs: claude-container --services)"
fi

if [ -n "$OVERLAY_BUILD" ]; then
    # Hash base image + build inputs (runtime concerns excluded) -> tag. For
    # directory overlays the inputs also include any extra context files the
    # Dockerfile can COPY, keyed by relative path so renames re-hash too.
    #
    # The base is keyed by its image ID (content), not just its tag: locally
    # rebuilding the base reuses the same tag, and hashing only the tag would
    # keep serving overlay images built from the stale base. Fall back to the
    # tag when the image isn't present locally yet (docker run pulls it later).
    BASE_IMAGE_KEY=$(docker image inspect --format '{{.Id}}' "$IMAGE" 2>/dev/null || printf '%s' "$IMAGE")
    if [ -n "$OVERLAY_CONTEXT" ]; then
        OVERLAY_HASH=$({
            printf '%s\n' "$IMAGE" "$BASE_IMAGE_KEY"
            printf '%s' "$OVERLAY_BUILD"
            (cd "$OVERLAY_CONTEXT" && find . -type f ! -name Dockerfile ! -name overlay.json ! -name startup.sh ! -path './skills/*' | LC_ALL=C sort | while IFS= read -r ctx_file; do
                printf '%s\n' "$ctx_file"
                cat "$ctx_file"
            done)
        } | sha256_12)
    else
        OVERLAY_HASH=$({ printf '%s\n' "$IMAGE" "$BASE_IMAGE_KEY"; printf '%s' "$OVERLAY_BUILD"; } | sha256_12)
    fi
    OVERLAY_IMAGE="claude-container-overlay:${OVERLAY_HASH}"

    # Confirm-before-rebuild, for rebuilds caused by SKILLS rather than by this
    # project. A user-wide skill is shared, so editing one (or adopting a new
    # one) would otherwise silently re-bake the image of every project that
    # accepted it, running that skill's fragment as root in each. Compare the
    # current fragment block against the one this project last built from: only
    # a change there prompts. A change to the project's own overlay Dockerfile
    # rebuilds silently, exactly as before this feature existed.
    SKILL_FRAGMENT_DIGEST=$(printf '%s' "$SKILL_FRAGMENT_BUILD" | sha256_12)
    BUILD_STATE_FILE="$(skill_build_state_file)"
    PREV_FRAGMENT_DIGEST=""
    PREV_OVERLAY_IMAGE=""
    if [ -f "$BUILD_STATE_FILE" ]; then
        PREV_FRAGMENT_DIGEST="$(sed -n 's/^fragments=//p' "$BUILD_STATE_FILE" | tail -1)"
        PREV_OVERLAY_IMAGE="$(sed -n 's/^image=//p' "$BUILD_STATE_FILE" | tail -1)"
    fi

    # "No recorded state" counts as a change: a project that has never built with
    # fragments is exactly the case where skills are about to alter its image for
    # the first time, which is the moment worth confirming. Projects with no
    # fragments at all never reach this and rebuild silently, as before.
    if ! docker image inspect "$OVERLAY_IMAGE" >/dev/null 2>&1 \
        && [ "$PREV_FRAGMENT_DIGEST" != "$SKILL_FRAGMENT_DIGEST" ] \
        && { [ -n "$SKILL_FRAGMENT_BUILD" ] || [ -n "$PREV_FRAGMENT_DIGEST" ]; }; then
        if [ -z "$PREV_FRAGMENT_DIGEST" ]; then
            echo -e "${YELLOW}Skills will build into this project's image for the first time.${NC}"
        else
            echo -e "${YELLOW}Skill image fragments changed for this project.${NC}"
        fi
        if [ ${#SKILL_FRAGMENT_NAMES[@]} -gt 0 ]; then
            echo -e "${YELLOW}Contributing skills (in build order):${NC} ${SKILL_FRAGMENT_NAMES[*]}"
        else
            echo -e "${YELLOW}No skill now contributes a fragment (one was removed or rejected).${NC}"
        fi
        echo -e "${YELLOW}Rebuilding runs their Dockerfile fragments as root in this image.${NC}"
        echo -e "${YELLOW}Review with: claude-container --skills-fragments${NC}"
        if [ ! -t 0 ] || [ ! -t 1 ]; then
            echo -e "${BLUE}Non-interactive launch — rebuilding.${NC}"
        else
            while true; do
                printf 'Rebuild the image now? [y]es / [n]o, keep the current image: '
                read -r answer < /dev/tty || answer="y"
                case "$answer" in
                    y|Y|yes|"")
                        break
                        ;;
                    n|N|no)
                        if [ -n "$PREV_OVERLAY_IMAGE" ] && docker image inspect "$PREV_OVERLAY_IMAGE" >/dev/null 2>&1; then
                            echo -e "${BLUE}Keeping ${PREV_OVERLAY_IMAGE}; the new fragments are NOT in it.${NC}"
                            echo -e "${BLUE}You'll be asked again next launch.${NC}"
                            OVERLAY_IMAGE="$PREV_OVERLAY_IMAGE"
                        else
                            echo -e "${YELLOW}The previously built image is gone; rebuilding anyway.${NC}"
                        fi
                        break
                        ;;
                    *)
                        echo "Please answer y or n."
                        ;;
                esac
            done
        fi
    fi

    if ! docker image inspect "$OVERLAY_IMAGE" >/dev/null 2>&1; then
        # Footgun guard: if the base ($IMAGE) is itself an overlay image, the
        # overlay's build steps get re-applied on top of it. Because the parent
        # differs from the shared base, Docker's layer cache misses and expensive
        # steps (e.g. a Nix install) re-run from scratch. This usually means
        # CLAUDE_IMAGE is pinned to a previously-built overlay — unset it so the
        # overlay builds from the shared base and reuses cached layers.
        if [[ "$IMAGE" == claude-container-overlay:* ]]; then
            echo -e "${YELLOW}Warning: base image '${IMAGE}' is itself an overlay image.${NC}"
            echo -e "${YELLOW}The overlay's build steps will be re-applied on top of it, which misses${NC}"
            echo -e "${YELLOW}Docker's layer cache and may re-run expensive steps. If CLAUDE_IMAGE is${NC}"
            echo -e "${YELLOW}pinned to a built overlay, unset it (fish: 'set -e CLAUDE_IMAGE') so the${NC}"
            echo -e "${YELLOW}overlay builds from the shared base and reuses cached layers.${NC}"
        fi
        echo -e "${GREEN}Building overlay image ${OVERLAY_IMAGE} from ${IMAGE}...${NC}"
        if [ -n "$OVERLAY_CONTEXT" ]; then
            # Directory overlay: build with the overlay directory as context so
            # COPY works; the effective Dockerfile (FROM + fragment) is fed on
            # stdin so the fragment itself never needs a FROM line.
            if ! { printf 'FROM %s\n' "$IMAGE"; printf '%s' "$OVERLAY_BUILD"; } | docker build -t "$OVERLAY_IMAGE" -f - "$OVERLAY_CONTEXT"; then
                echo -e "${RED}Error: Failed to build overlay image${NC}"
                exit 1
            fi
        else
            BUILD_DIR="$(mktemp -d)"
            trap 'rm -rf "$BUILD_DIR"' EXIT
            {
                printf 'FROM %s\n' "$IMAGE"
                printf '%s' "$OVERLAY_BUILD"
            } > "$BUILD_DIR/Dockerfile"
            if ! docker build -t "$OVERLAY_IMAGE" "$BUILD_DIR"; then
                echo -e "${RED}Error: Failed to build overlay image${NC}"
                exit 1
            fi
            rm -rf "$BUILD_DIR"
            trap - EXIT
        fi
    fi
    # Record what this project is actually running, so the next launch can tell
    # a skill-driven change apart from a project-driven one. Written whether or
    # not a build just happened: declining a rebuild must not leave the recorded
    # digest stale, or the prompt would never fire again.
    if [ "$OVERLAY_IMAGE" = "claude-container-overlay:${OVERLAY_HASH}" ]; then
        mkdir -p "$SKILL_CHOICES_DIR"
        {
            printf '# claude-container: last overlay image built for this project\n'
            printf 'image=%s\n' "$OVERLAY_IMAGE"
            printf 'fragments=%s\n' "$SKILL_FRAGMENT_DIGEST"
        } > "$BUILD_STATE_FILE"
    fi
    IMAGE="$OVERLAY_IMAGE"
fi

# Handle proxy mode
if [ "$USE_PROXY" = true ]; then
    # Convert proxy data dir to absolute path
    PROXY_DATA_DIR="$(cd "$(dirname "$PROXY_DATA_DIR")" 2>/dev/null && pwd)/$(basename "$PROXY_DATA_DIR")" || PROXY_DATA_DIR="$(pwd)/$(basename "$PROXY_DATA_DIR")"
    mkdir -p "$PROXY_DATA_DIR"
    PROXY_DATA_DIR="$(cd "$PROXY_DATA_DIR" && pwd)"

    # Set trap for cleanup
    trap cleanup EXIT INT TERM

    # Start proxy
    start_proxy

    # Start datasette if requested
    if [ "$USE_DATASETTE" = true ]; then
        start_datasette
    fi

    echo -e "\n${GREEN}Starting Claude Container with API logging...${NC}"
    echo -e "Version:    ${YELLOW}$VERSION${NC}"
    echo -e "Workspace:  ${YELLOW}$WORKSPACE_DIR${NC}"
    echo -e "Config:     ${YELLOW}$CONFIG_DIR${NC}"
    echo -e "Proxy logs: ${YELLOW}$PROXY_DATA_DIR/requests.db${NC}"
    if [ "$USE_DATASETTE" = true ]; then
        echo -e "Datasette:  ${YELLOW}http://localhost:${DATASETTE_PORT}${NC}"
    fi
    echo ""

    # Run the container with proxy. The svc-mux publish uses an EPHEMERAL host
    # port (empty host part) so concurrent containers never collide; the
    # background registration discovers the assigned port via `docker port`.
    # Start any launcher-supervised host services (mount/tcp bridges) before the
    # container, so a mount watcher is waiting on the mailbox and a tcp service's
    # discovery env var is injected below. Torn down by cleanup on exit.
    start_host_services
    register_services_async
    docker run --rm -it \
        --name "$CC_CONTAINER_NAME" \
        --network "$NETWORK_NAME" \
        -v "$WORKSPACE_DIR:/workspace" \
        -v "$CONFIG_DIR:/claude" \
        -e "CLAUDE_CONFIG_DIR=/claude" \
        -e "ANTHROPIC_BASE_URL=http://$PROXY_CONTAINER_NAME:8080" \
        -e "USER_UID=$(id -u)" \
        -e "USER_GID=$(id -g)" \
        -e "CLAUDE_SERVICE_INSTANCE=$SERVICE_INSTANCE" \
        -p "127.0.0.1::${MUX_CONTAINER_PORT}" \
        "${PORT_ARGS[@]}" \
        "${OVERLAY_RUNTIME_ARGS[@]}" \
        "${EXTRA_DOCKER_ARGS[@]}" \
        "$IMAGE" \
        $COMMAND

    # Note: Proxy and Datasette are intentionally left running for potential subsequent runs
    if [ "$USE_DATASETTE" = true ]; then
        echo -e "\n${BLUE}Proxy and Datasette containers are still running.${NC}"
        echo -e "${BLUE}Datasette UI: http://localhost:${DATASETTE_PORT}${NC}"
        echo -e "${BLUE}Use '$0 --proxy-stop' to stop both containers.${NC}"
    else
        echo -e "\n${BLUE}Proxy container is still running. Use '$0 --proxy-stop' to stop it.${NC}"
    fi
else
    # Run without proxy
    echo -e "${GREEN}Starting Claude Container...${NC}"
    echo -e "Version:   ${YELLOW}$VERSION${NC}"
    echo -e "Workspace: ${YELLOW}$WORKSPACE_DIR${NC}"
    echo -e "Config:    ${YELLOW}$CONFIG_DIR${NC}"
    echo ""

    # Deregister the instance when the launch ends (no proxy cleanup needed).
    trap cleanup EXIT INT TERM

    # Run the container. The svc-mux publish uses an EPHEMERAL host port (empty
    # host part) so concurrent containers never collide; the background
    # registration discovers the assigned port via `docker port`.
    # Start any launcher-supervised host services (mount/tcp bridges) before the
    # container, so a mount watcher is waiting on the mailbox and a tcp service's
    # discovery env var is injected below. Torn down by cleanup on exit.
    start_host_services
    register_services_async
    docker run --rm -it \
        --name "$CC_CONTAINER_NAME" \
        -v "$WORKSPACE_DIR:/workspace" \
        -v "$CONFIG_DIR:/claude" \
        -e "CLAUDE_CONFIG_DIR=/claude" \
        -e "USER_UID=$(id -u)" \
        -e "USER_GID=$(id -g)" \
        -e "CLAUDE_SERVICE_INSTANCE=$SERVICE_INSTANCE" \
        -p "127.0.0.1::${MUX_CONTAINER_PORT}" \
        "${PORT_ARGS[@]}" \
        "${OVERLAY_RUNTIME_ARGS[@]}" \
        "${EXTRA_DOCKER_ARGS[@]}" \
        "$IMAGE" \
        $COMMAND
fi
